<script>
(function () {
    const input   = document.getElementById('live-search');
    const hint    = document.getElementById('search-hint');
    const tbody   = document.getElementById('user-tbody');
    const SEARCH_URL = '{{ path('app_user_search') }}';

    // CSRF tokens are embedded per-row from Twig; for dynamic rows we fetch fresh ones via a hidden endpoint.
    // Since block/delete need CSRF, we keep the forms but generate tokens server-side per user.
    // We embed a Twig-generated token map for all currently-loaded users and refresh on search.
    // Simpler approach: use a per-action token fetched inline.

    let debounceTimer = null;

    function highlight(text, query) {
        if (!query) return escHtml(text);
        const re = new RegExp('(' + query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
        return escHtml(text).replace(re, '<mark style="background:rgba(16,185,129,.35);color:inherit;border-radius:3px;">$1</mark>');
    }

    function escHtml(str) {
        return String(str)
            .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    function renderRows(users, q) {
        if (!users.length) {
            tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:40px;">No users found${q ? ' for &ldquo;' + escHtml(q) + '&rdquo;' : ''}</td></tr>`;
            return;
        }

        tbody.innerHTML = users.map(u => {
            const initials  = escHtml(u.name.slice(0,2).toUpperCase());
            const nameHl    = highlight(u.name,  q);
            const emailHl   = highlight(u.email, q);
            const idHl      = highlight(String(u.id), q);
            const blocked   = u.isBlocked;
            const statusBadge = blocked
                ? '<span class="status-badge pending">Blocked</span>'
                : '<span class="status-badge completed">Active</span>';
            const roles = u.roles.map(r =>
                `<span class="status-badge completed" style="font-size:11px;margin:2px;">${escHtml(r)}</span>`
            ).join('');
            const blockIcon  = blocked ? '🔓' : '🔒';
            const blockBg    = blocked ? 'linear-gradient(135deg,var(--success),var(--emerald))' : 'rgba(255,255,255,0.1)';
            const blockTitle = blocked ? 'Unblock' : 'Block';
            const blockToken = u.blockToken  || '';
            const deleteToken= u.deleteToken || '';

            return `
            <tr>
                <td>${idHl}</td>
                <td>
                    <div class="table-user">
                        <div class="table-avatar" style="background:linear-gradient(135deg,var(--emerald-light),var(--emerald));">${initials}</div>
                        <span class="table-user-name">${nameHl}</span>
                    </div>
                </td>
                <td>${emailHl}</td>
                <td>${roles}</td>
                <td>${statusBadge}</td>
                <td style="text-align:center;">
                    <div style="display:inline-flex;gap:5px;">
                        <a href="${escHtml(u.showUrl)}" class="card-btn" style="padding:5px 10px;font-size:12px;" title="View">👁️</a>
                        <a href="${escHtml(u.editUrl)}" class="card-btn" style="padding:5px 10px;font-size:12px;" title="Edit">✏️</a>
                        <form method="post" action="${escHtml(u.blockUrl)}" style="display:inline;" data-user-id="${u.id}" class="block-form">
                            <input type="hidden" name="_token" value="${escHtml(blockToken)}">
                            <button type="submit" class="card-btn"
                                style="padding:5px 10px;font-size:12px;background:${blockBg};"
                                onclick="return confirm('Are you sure?')"
                                title="${blockTitle}">${blockIcon}</button>
                        </form>
                        <form method="post" action="${escHtml(u.deleteUrl)}" style="display:inline;" class="delete-form" data-user-id="${u.id}">
                            <input type="hidden" name="_token" value="${escHtml(deleteToken)}">
                            <button type="submit" class="card-btn"
                                style="padding:5px 10px;font-size:12px;background:linear-gradient(135deg,#ef4444,#dc2626);"
                                onclick="return confirm('Delete this user?')"
                                title="Delete">🗑️</button>
                        </form>
                    </div>
                </td>
            </tr>`;
        }).join('');
    }

    async function fetchTokens(users) {
        // Fetch CSRF tokens for block and delete for each user via a lightweight approach:
        // We use the Symfony csrf_token() which is session-based, so we fetch them from a
        // hidden endpoint or embed them via a data attribute on the page.
        // Simplest: fetch /user/csrf-tokens?ids=1,2,3
        // Instead, we embed them in a <script> tag on the page for the initial load,
        // and for dynamic results we request them from the server.
        const ids = users.map(u => u.id).join(',');
        try {
            const resp = await fetch(`{{ path('app_user_csrf_tokens') }}?ids=${ids}`);
            if (!resp.ok) return {};
            return await resp.json();
        } catch { return {}; }
    }

    async function doSearch(q) {
        const url = SEARCH_URL + (q ? '?q=' + encodeURIComponent(q) : '');
        try {
            const resp  = await fetch(url);
            const users = await resp.json();

            // Fetch CSRF tokens for these users
            const tokens = await fetchTokens(users);
            users.forEach(u => {
                u.blockToken  = tokens[u.id]?.block  || '';
                u.deleteToken = tokens[u.id]?.delete || '';
            });

            renderRows(users, q);
        } catch (e) {
            console.error('Search error', e);
        }
    }

    // Update hint text
    function updateHint(q) {
        if (!q) { hint.textContent = ''; return; }
        if (/^\d+$/.test(q)) {
            hint.textContent = '🔢 Searching by ID: ' + q;
        } else if (q.includes('@')) {
            hint.textContent = '📧 Searching by email';
        } else {
            hint.textContent = '👤 Searching by name or email';
        }
    }

    input.addEventListener('input', function () {
        const q = this.value.trim();
        updateHint(q);
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => doSearch(q), 220);
    });

    // Focus style
    input.addEventListener('focus', () => input.style.borderColor = 'var(--emerald)');
    input.addEventListener('blur',  () => input.style.borderColor = 'rgba(255,255,255,0.15)');
})();
</script>
</body>
</html>
