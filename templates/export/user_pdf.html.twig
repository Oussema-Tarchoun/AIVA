<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: sans-serif; }
        .header { text-align: center; margin-bottom: 30px; }
        .profile-table { width: 100%; border-collapse: collapse; }
        .profile-table th, .profile-table td { border: 1px solid #ddd; padding: 12px; text-align: left; }
        .profile-table th { background-color: #f2f2f2; }
        .footer { margin-top: 50px; font-size: 12px; text-align: center; color: #777; }
    </style>
</head>
<body>
    <div class="header">
        <h1>User Profile Data Export</h1>
        <p>AIVA Security & Management System</p>
    </div>

    <table class="profile-table">
        <thead>
            <tr>
                <th>Field</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            {% for key, value in data %}
            <tr>
                <td><strong>{{ key }}</strong></td>
                <td>
                    {% if value is iterable %}
                        {{ value|join(', ') }}
                    {% else %}
                        {{ value }}
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        Generated on {{ "now"|date("Y-m-d H:i:s") }}
    </div>
</body>
</html>
