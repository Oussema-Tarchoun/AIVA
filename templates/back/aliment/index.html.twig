{% extends 'base.html.twig' %}

{% block title %}Aliments{% endblock %}

{% block body %}
<style>
    .main-content {
        margin-left: 15% !important;
    }
</style>
<!-- Sidebar -->
<aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo">
            <img src="{{ asset('images/logo.png') }}" alt="Logo"
                 style="width: 80px; display: block; margin: 12px auto;">
        </div>
        <span class="logo-text">EnergyDash</span>
    </div>

    <ul class="nav-menu">

        {# Menu Principal #}
        <li class="nav-section">
            <span class="nav-section-title">Menu Principal</span>
            <ul>
                <li class="nav-item">
                    <a href="{{ path('dashboard') }}"
                       class="nav-link {% if app.request.attributes.get('_route') == 'dashboard' %}active{% endif %}">
                        <i class="fa-solid fa-house"></i> Tableau de bord
                    </a>
                </li>
            </ul>
        </li>

        {# Menu énergies #}
        <li class="nav-section">
            <span class="nav-section-title">Menu énergies</span>
            <ul>
                <li class="nav-item">
                    <a href="{{ path('energy') }}"
                       class="nav-link {% if app.request.attributes.get('_route') == 'energy' %}active{% endif %}">
                        <i class="fa-solid fa-bolt"></i> Consommation d'énergie
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('recommendations') }}"
                       class="nav-link {% if app.request.attributes.get('_route') == 'recommendations' %}active{% endif %}">
                        <i class="fa-solid fa-lightbulb"></i> Recommandations
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('stateenergi') }}"
                       class="nav-link {% if app.request.attributes.get('_route') == 'stateenergi' %}active{% endif %}">
                        <i class="fa-solid fa-chart-line"></i> Statistiques d'énergie
                    </a>
                </li>
            </ul>
        </li>

        {# ✅ Menu Nutrition (Aliments + Repas) #}
        <li class="nav-section">
            <span class="nav-section-title">Nutrition</span>
            <ul>
                <li class="nav-item">
                    <a href="{{ path('app_aliment_index') }}"
                       class="nav-link {% if app.request.attributes.get('_route') starts with 'app_aliment_' %}active{% endif %}">
                        <i class="fa-solid fa-apple-whole"></i> Aliments
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_repas_index') }}"
                       class="nav-link {% if app.request.attributes.get('_route') starts with 'repas_aliment_' %}active{% endif %}">
                        <i class="fa-solid fa-utensils"></i> Repas
                    </a>
                </li>
            </ul>
        </li>

        {# ✅ Menu Formation (Cours/Chapitres) #}
        <li class="nav-section">
            <span class="nav-section-title">Formation</span>
            <ul>
                <li class="nav-item">
                    <a href="{{ path('app_cours_index') }}"
                       class="nav-link {% if app.request.attributes.get('_route') starts with 'app_cours_' %}active{% endif %}">
                        <i class="fa-solid fa-book"></i> Cours
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_chapitre_index') }}"
                       class="nav-link {% if app.request.attributes.get('_route') starts with 'app_chapitre_' %}active{% endif %}">
                        <i class="fa-solid fa-list"></i> Chapitres
                    </a>
                </li>
            </ul>
        </li>

        {# Compte #}
        <li class="nav-section">
            <span class="nav-section-title">Compte</span>
            <ul>
                <li class="nav-item">
                    <a href="{{ path('app_profile') }}"
                       class="nav-link {% if app.request.attributes.get('_route') == 'app_profile' %}active{% endif %}">
                        <i class="fa-solid fa-user"></i> Profil
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_user_index') }}"
                       class="nav-link {% if app.request.attributes.get('_route') starts with 'app_user_' %}active{% endif %}">
                        <i class="fa-solid fa-users"></i> Users
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_logout') }}" class="nav-link">
                        <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
                    </a>
                </li>
            </ul>
        </li>

    </ul>
</aside>
<div class="main-content">
    <nav class="navbar">
        <div class="page-header">
            <h1 class="page-title">Mes Aliments</h1>
            <div class="page-breadcrumb">
                <a href="{{ path('dashboard') }}">Dashboard</a>
                <span>/</span>
                <span>Aliments</span>
            </div>
        </div>
        <div class="navbar-right">
            <a href="{{ path('app_aliment_new') }}" class="btn btn-primary" style="width: auto; padding: 10px 20px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Nouvel Aliment
            </a>
        </div>
    </nav>

    {# Afficher les messages flash d'erreur #}
    {% for message in app.flashes('error') %}
        <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #ef4444; padding: 12px 16px; border-radius: 12px; margin-bottom: 20px;">
            <strong>Erreur:</strong> {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('success') %}
        <div style="background: rgba(5, 150, 105, 0.15); border: 1px solid var(--emerald); color: var(--emerald); padding: 12px 16px; border-radius: 12px; margin-bottom: 20px;">
            <strong>Succès:</strong> {{ message }}
        </div>
    {% endfor %}

    <div class="glass-card">
        <div class="settings-section">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 16px;">
                <h3 class="settings-section-title" style="margin: 0;">Liste des Aliments</h3>
                
                {# Barre de recherche #}
                <form method="get" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                    <input type="text" 
                           name="search" 
                           placeholder="Rechercher un aliment..." 
                           value="{{ current_search|default('') }}"
                           style="padding: 8px 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.05); color: var(--text); min-width: 250px;">
                    
                    <input type="hidden" name="sort" value="{{ current_sort|default('nom') }}">
                    <input type="hidden" name="order" value="{{ current_order|default('ASC') }}">
                    
                    <button type="submit" class="card-btn" style="padding: 8px 16px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                        </svg>
                        Rechercher
                    </button>
                    
                    {% if current_search|default('') %}
                        <a href="{{ path('app_aliment_index') }}" class="card-btn" style="padding: 8px 16px;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                            Réinitialiser
                        </a>
                    {% endif %}
                </form>
            </div>
            
            {% if aliments|length > 0 %}
            <div class="table-wrapper" style="margin: 0;">
                <table class="data-table" style="min-width: 100%;">
                    <thead>
                        <tr>
                            <th>
                                <a href="{{ path('app_aliment_index', {
                                    search: current_search|default(''),
                                    sort: 'id',
                                    order: (current_sort == 'id' and current_order == 'ASC') ? 'DESC' : 'ASC'
                                }) }}" style="color: inherit; text-decoration: none; display: flex; align-items: center; gap: 4px; cursor: pointer;">
                                    ID
                                    {% if current_sort == 'id' %}
                                        <span style="font-size: 14px;">{{ current_order == 'ASC' ? '↑' : '↓' }}</span>
                                    {% else %}
                                        <span style="font-size: 14px; opacity: 0.3;">↕</span>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('app_aliment_index', {
                                    search: current_search|default(''),
                                    sort: 'nom',
                                    order: (current_sort == 'nom' and current_order == 'ASC') ? 'DESC' : 'ASC'
                                }) }}" style="color: inherit; text-decoration: none; display: flex; align-items: center; gap: 4px; cursor: pointer;">
                                    Nom
                                    {% if current_sort == 'nom' %}
                                        <span style="font-size: 14px;">{{ current_order == 'ASC' ? '↑' : '↓' }}</span>
                                    {% else %}
                                        <span style="font-size: 14px; opacity: 0.3;">↕</span>
                                    {% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('app_aliment_index', {
                                    search: current_search|default(''),
                                    sort: 'quantite',
                                    order: (current_sort == 'quantite' and current_order == 'ASC') ? 'DESC' : 'ASC'
                                }) }}" style="color: inherit; text-decoration: none; display: flex; align-items: center; gap: 4px; cursor: pointer;">
                                    Quantité
                                    {% if current_sort == 'quantite' %}
                                        <span style="font-size: 14px;">{{ current_order == 'ASC' ? '↑' : '↓' }}</span>
                                    {% else %}
                                        <span style="font-size: 14px; opacity: 0.3;">↕</span>
                                    {% endif %}
                                </a>
                            </th>
                            <th>Protéines</th>
                            <th>Glucides</th>
                            <th>Lipides</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for aliment in aliments %}
                        {% set macro = aliment.macro %}
                        <tr>
                            <td><span class="table-id">#{{ aliment.id }}</span></td>
                            <td><strong>{{ aliment.nom }}</strong></td>
                            <td><span class="table-amount">{{ aliment.quantite }}g</span></td>
                            <td>
                                <span style="color: rgba(5, 150, 105, 0.9); font-weight: 500;">
                                    {{ macro.proteine|default('0') }}g
                                </span>
                            </td>
                            <td>
                                <span style="color: rgba(212, 165, 116, 0.9); font-weight: 500;">
                                    {{ macro.glucide|default('0') }}g
                                </span>
                            </td>
                            <td>
                                <span style="color: rgba(15, 6, 23, 0.9); font-weight: 500;">
                                    {{ macro.lipide|default('0') }}g
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    <a href="{{ path('app_aliment_show', {'id': aliment.id}) }}" class="card-btn" style="padding: 6px 12px;">Voir</a>
                                    <a href="{{ path('app_aliment_edit', {'id': aliment.id}) }}" class="card-btn" style="padding: 6px 12px;">Modifier</a>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            {# Affichage du nombre de résultats #}
            <div style="margin-top: 16px; padding: 12px; background: rgba(255,255,255,0.03); border-radius: 8px; text-align: center; color: var(--text-muted); font-size: 14px;">
                {% if current_search|default('') %}
                    {{ aliments|length }} résultat(s) trouvé(s) pour "{{ current_search }}"
                {% else %}
                    {{ aliments|length }} aliment(s) au total
                {% endif %}
            </div>
            {% else %}
            <div style="text-align: center; padding: 48px 24px; color: var(--text-muted);">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin: 0 auto 16px; opacity: 0.3;">
                    <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
                    <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
                    <line x1="6" y1="1" x2="6" y2="4"/>
                    <line x1="10" y1="1" x2="10" y2="4"/>
                    <line x1="14" y1="1" x2="14" y2="4"/>
                </svg>
                {% if current_search|default('') %}
                    <p style="font-size: 18px; margin-bottom: 8px; font-weight: 500;">Aucun aliment trouvé</p>
                    <p style="font-size: 14px; margin-bottom: 16px;">Aucun résultat pour "{{ current_search }}"</p>
                    <a href="{{ path('app_aliment_index') }}" class="btn btn-primary" style="width: auto; margin-top: 8px; padding: 10px 20px;">
                        Voir tous les aliments
                    </a>
                {% else %}
                    <p style="font-size: 18px; margin-bottom: 8px; font-weight: 500;">Aucun aliment trouvé</p>
                    <p style="font-size: 14px; margin-bottom: 16px;">Commencez par créer votre premier aliment</p>
                    <a href="{{ path('app_aliment_new') }}" class="btn btn-primary" style="width: auto; margin-top: 8px; padding: 10px 20px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
                            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        Créer un Aliment
                    </a>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}