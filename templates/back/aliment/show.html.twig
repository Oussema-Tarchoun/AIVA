{% extends 'base.html.twig' %}

{% block title %}{{ aliment.nom }}{% endblock %}

{% block body %}
<style>
    .main-content {
        margin-left: 15% !important;
    }
</style>
<!-- Sidebar -->
<aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo">
            <img src="{{ asset('images/logo.png') }}" alt="Logo"
                 style="width: 80px; display: block; margin: 12px auto;">
        </div>
        <span class="logo-text">EnergyDash</span>
    </div>

    <ul class="nav-menu">

        {# Menu Principal #}
        <li class="nav-section">
            <span class="nav-section-title">Menu Principal</span>
            <ul>
                <li class="nav-item">
                    <a href="{{ path('dashboard') }}"
                       class="nav-link {% if app.request.attributes.get('_route') == 'dashboard' %}active{% endif %}">
                        <i class="fa-solid fa-house"></i> Tableau de bord
                    </a>
                </li>
            </ul>
        </li>

        {# Menu énergies #}
        <li class="nav-section">
            <span class="nav-section-title">Menu énergies</span>
            <ul>
                <li class="nav-item">
                    <a href="{{ path('energy') }}"
                       class="nav-link {% if app.request.attributes.get('_route') == 'energy' %}active{% endif %}">
                        <i class="fa-solid fa-bolt"></i> Consommation d'énergie
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('recommendations') }}"
                       class="nav-link {% if app.request.attributes.get('_route') == 'recommendations' %}active{% endif %}">
                        <i class="fa-solid fa-lightbulb"></i> Recommandations
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('stateenergi') }}"
                       class="nav-link {% if app.request.attributes.get('_route') == 'stateenergi' %}active{% endif %}">
                        <i class="fa-solid fa-chart-line"></i> Statistiques d'énergie
                    </a>
                </li>
            </ul>
        </li>

        {# ✅ Menu Nutrition (Aliments + Repas) #}
        <li class="nav-section">
            <span class="nav-section-title">Nutrition</span>
            <ul>
                <li class="nav-item">
                    <a href="{{ path('app_aliment_index') }}"
                       class="nav-link {% if app.request.attributes.get('_route') starts with 'app_aliment_' %}active{% endif %}">
                        <i class="fa-solid fa-apple-whole"></i> Aliments
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_repas_index') }}"
                       class="nav-link {% if app.request.attributes.get('_route') starts with 'repas_aliment_' %}active{% endif %}">
                        <i class="fa-solid fa-utensils"></i> Repas
                    </a>
                </li>
            </ul>
        </li>

        {# ✅ Menu Formation (Cours/Chapitres) #}
        <li class="nav-section">
            <span class="nav-section-title">Formation</span>
            <ul>
                <li class="nav-item">
                    <a href="{{ path('app_cours_index') }}"
                       class="nav-link {% if app.request.attributes.get('_route') starts with 'app_cours_' %}active{% endif %}">
                        <i class="fa-solid fa-book"></i> Cours
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_chapitre_index') }}"
                       class="nav-link {% if app.request.attributes.get('_route') starts with 'app_chapitre_' %}active{% endif %}">
                        <i class="fa-solid fa-list"></i> Chapitres
                    </a>
                </li>
            </ul>
        </li>

        {# Compte #}
        <li class="nav-section">
            <span class="nav-section-title">Compte</span>
            <ul>
                <li class="nav-item">
                    <a href="{{ path('app_profile') }}"
                       class="nav-link {% if app.request.attributes.get('_route') == 'app_profile' %}active{% endif %}">
                        <i class="fa-solid fa-user"></i> Profil
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_user_index') }}"
                       class="nav-link {% if app.request.attributes.get('_route') starts with 'app_user_' %}active{% endif %}">
                        <i class="fa-solid fa-users"></i> Users
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_logout') }}" class="nav-link">
                        <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
                    </a>
                </li>
            </ul>
        </li>

    </ul>
</aside>
<div class="main-content">
    <nav class="navbar">
        <div class="page-header">
            <h1 class="page-title">{{ aliment.nom }}</h1>
            <div class="page-breadcrumb">
                <a href="{{ path('dashboard') }}">Dashboard</a>
                <span>/</span>
                <a href="{{ path('app_aliment_index') }}">Aliments</a>
                <span>/</span>
                <span>Détails</span>
            </div>
        </div>
        <div class="navbar-right">
            <a href="{{ path('app_aliment_edit', {'id': aliment.id}) }}" class="btn btn-primary" style="width: auto; padding: 10px 20px; margin-right: 12px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
                Modifier
            </a>
            <a href="{{ path('app_aliment_index') }}" class="btn btn-secondary" style="width: auto; padding: 10px 20px;">
                Retour
            </a>
        </div>
    </nav>

    {% set macro = aliment.macro %}

    <div class="settings-grid">
        <div class="glass-card settings-nav-card">
            <div style="padding: 20px;">
                <div class="profile-avatar-large" style="width: 100px; height: 100px; font-size: 36px; margin: 0 auto 20px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 50px; height: 50px;">
                        <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
                        <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
                        <line x1="6" y1="1" x2="6" y2="4"/>
                        <line x1="10" y1="1" x2="10" y2="4"/>
                        <line x1="14" y1="1" x2="14" y2="4"/>
                    </svg>
                </div>
                <h3 style="text-align: center; margin-bottom: 8px;">{{ aliment.nom }}</h3>
                <p style="text-align: center; color: var(--text-muted); font-size: 14px;">Aliment</p>
                
                <div style="margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--glass-border);">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
                        <span style="color: var(--text-muted); font-size: 14px;">Quantité</span>
                        <span style="font-weight: 500; color: var(--emerald);">{{ aliment.quantite }}g</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
                        <span style="color: var(--text-muted); font-size: 14px;">Utilisé dans</span>
                        <span style="font-weight: 500;">{{ aliment.repas|length }} repas</span>
                    </div>
                </div>
                
                {{ include('back/aliment/_delete_form.html.twig', {button_label: 'Supprimer', button_attr: {class: 'btn', style: 'width: 100%; margin-top: 20px; background: rgba(239, 68, 68, 0.15); color: #ef4444;'}}) }}
            </div>
        </div>

        <div class="glass-card">
            <div class="settings-section">
                <h3 class="settings-section-title">Valeurs Nutritionnelles (pour {{ aliment.quantite }}g)</h3>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 24px;">
                    <div style="background: linear-gradient(135deg, rgba(5, 150, 105, 0.1), rgba(5, 150, 105, 0.05)); padding: 20px; border-radius: 12px; border: 1px solid var(--glass-border);">
                        <div style="font-size: 14px; color: var(--text-muted); margin-bottom: 8px;">Protéines</div>
                        <div style="font-size: 24px; font-weight: 600; font-family: 'Space Mono', monospace; color: rgba(5, 150, 105, 0.9);">
                            {{ macro.proteine|default('0') }}g
                        </div>
                    </div>
                    
                    <div style="background: linear-gradient(135deg, rgba(212, 165, 116, 0.1), rgba(212, 165, 116, 0.05)); padding: 20px; border-radius: 12px; border: 1px solid var(--glass-border);">
                        <div style="font-size: 14px; color: var(--text-muted); margin-bottom: 8px;">Glucides</div>
                        <div style="font-size: 24px; font-weight: 600; font-family: 'Space Mono', monospace; color: rgba(212, 165, 116, 0.9);">
                            {{ macro.glucide|default('0') }}g
                        </div>
                    </div>
                    
                    <div style="background: linear-gradient(135deg, rgba(147, 51, 234, 0.1), rgba(147, 51, 234, 0.05)); padding: 20px; border-radius: 12px; border: 1px solid var(--glass-border);">
                        <div style="font-size: 14px; color: var(--text-muted); margin-bottom: 8px;">Lipides</div>
                        <div style="font-size: 24px; font-weight: 600; font-family: 'Space Mono', monospace; color: rgba(147, 51, 234, 0.9);">
                            {{ macro.lipide|default('0') }}g
                        </div>
                    </div>
                </div>
            </div>

            {% if aliment.repas|length > 0 %}
            <div class="settings-section">
                <h3 class="settings-section-title">Utilisé dans les Repas ({{ aliment.repas|length }})</h3>
                
                <div class="table-wrapper" style="margin: 0;">
                    <table class="data-table" style="min-width: 100%;">
                        <thead>
                            <tr>
                                <th>Repas</th>
                                <th>Type</th>
                                <th>Heure</th>
                                <th>Calories</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for repas in aliment.repas %}
                            <tr>
                                <td><strong>{{ repas.nom }}</strong></td>
                                <td style="text-transform: capitalize;">{{ repas.type|replace({'-': ' '}) }}</td>
                                <td>{{ repas.heure ? repas.heure|date('H:i') : 'N/A' }}</td>
                                <td><span class="table-amount">{{ repas.calories }} kcal</span></td>
                                <td>
                                    <a href="{{ path('app_repas_show', {'id': repas.id}) }}" class="card-btn" style="padding: 6px 12px;">Voir</a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% else %}
            <div class="settings-section">
                <p style="color: var(--text-muted); text-align: center; padding: 24px;">
                    Cet aliment n'est utilisé dans aucun repas pour le moment.
                </p>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}