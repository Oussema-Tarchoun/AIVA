<form method="post"
      action="{{ path('app_depense_delete', {'id': depense.idDepense}) }}"
      onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ depense.idDepense) }}">
    <button class="btn">Delete</button>
</form>
