  {# ✅ Activités added #}
              <span class="nav-section-title">sports</span>

        <li class="nav-item">
            <a href="{{ path('back_sport_index') }}"
               class="nav-link {% if app.request.attributes.get('_route') starts with 'back_sport_' %}active{% endif %}">
