{# templates/chapitre/index.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chapitres - GlassDash</title>
    <meta name="description" content="3D Glassmorphism Dashboard Template by TemplateMo">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/templatemo-glass-admin-style.css') }}">
    <style>
        .filter-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            margin-top: 10px;
        }
        .filter-row input,
        .filter-row select {
            background: rgba(15, 23, 42, 0.8);
            border-radius: 999px;
            border: 1px solid rgba(148, 163, 184, 0.5);
            padding: 6px 10px;
            font-size: 12px;
            color: #e5e7eb;
            outline: none;
        }
        .filter-row button {
            border-radius: 999px;
            border: 1px solid rgba(59, 130, 246, 0.8);
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.9), rgba(37, 99, 235, 0.9));
            padding: 6px 14px;
            font-size: 12px;
            color: #f9fafb;
            cursor: pointer;
        }
        .chapters-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 18px;
            font-size: 12px;
        }
        .chapters-table th,
        .chapters-table td {
            padding: 8px 10px;
            border-bottom: 1px solid rgba(31, 41, 55, 0.9);
        }
        .chapters-table th {
            text-align: left;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #9ca3af;
        }
        .badge-small {
            display: inline-block;
            padding: 2px 7px;
            border-radius: 999px;
            border: 1px solid rgba(148, 163, 184, 0.5);
            font-size: 10px;
            color: #e5e7eb;
        }
    </style>
</head>
<body>
<div class="background"></div>
<div class="orb orb-1"></div>
<div class="orb orb-2"></div>
<div class="orb orb-3"></div>

<div class="dashboard">
          <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <img src="{{ asset('images/logo.png') }}" alt="Logo" style="width: 80px; display: block; margin: 12px auto;">
            </div>
            <span class="logo-text">EnergyDash</span>
        </div>

        <ul class="nav-menu">

            {# Menu Principal #}
            <li class="nav-section">
                <span class="nav-section-title">Menu Principal</span>
                <ul>
                    <li class="nav-item">
                        <a href="{{ path('dashboard') }}"
                           class="nav-link {% if app.request.attributes.get('_route') == 'dashboard' %}active{% endif %}">
                            <i class="fa-solid fa-house"></i> Tableau de bord
                        </a>
                    </li>
                </ul>
            </li>

            {# Menu énergies #}
            <li class="nav-section">
                <span class="nav-section-title">Menu énergies</span>
                <ul>
                    <li class="nav-item">
                        <a href="{{ path('energy') }}"
                           class="nav-link {% if app.request.attributes.get('_route') == 'energy' %}active{% endif %}">
                            <i class="fa-solid fa-bolt"></i> Consommation d'énergie
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="{{ path('recommendations') }}"
                           class="nav-link {% if app.request.attributes.get('_route') == 'recommendations' %}active{% endif %}">
                            <i class="fa-solid fa-lightbulb"></i> Recommandations
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="{{ path('stateenergi') }}"
                           class="nav-link {% if app.request.attributes.get('_route') == 'stateenergi' %}active{% endif %}">
                            <i class="fa-solid fa-chart-line"></i> Statistiques d'énergie
                        </a>
                    </li>
                </ul>
            </li>

            {# ✅ Menu Formation (Cours/Chapitres) #}
            <li class="nav-section">
                <span class="nav-section-title">Formation</span>
                <ul>
                    <li class="nav-item">
                        <a href="{{ path('app_cours_index') }}"
                           class="nav-link {% if app.request.attributes.get('_route') starts with 'app_cours_' %}active{% endif %}">
                            <i class="fa-solid fa-book"></i> Cours
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="{{ path('app_chapitre_index') }}"
                           class="nav-link {% if app.request.attributes.get('_route') starts with 'app_chapitre_' %}active{% endif %}">
                            <i class="fa-solid fa-list"></i> Chapitres
                        </a>
                    </li>
                </ul>
            </li>

            {# Compte #}
            <li class="nav-section">
                <span class="nav-section-title">Compte</span>
                <ul>
                    <li class="nav-item">
                        <a href="{{ path('app_profile') }}"
                           class="nav-link {% if app.request.attributes.get('_route') == 'app_profile' %}active{% endif %}">
                            <i class="fa-solid fa-user"></i> Profil
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="{{ path('app_user_index') }}"
                           class="nav-link {% if app.request.attributes.get('_route') starts with 'app_user_' %}active{% endif %}">
                            <i class="fa-solid fa-users"></i> Users
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="{{ path('app_logout') }}" class="nav-link">
                            <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
                        </a>
                    </li>
                </ul>
            </li>

        </ul>
    </aside>
   

    <!-- Main Content -->
    <main class="main-content">
        <nav class="navbar">
            <div class="page-header">
                <h1 class="page-title">
                    {% if cour is not null %}
                        Chapitres du cours : {{ cour.tittre }}
                    {% else %}
                        Chapitres
                    {% endif %}
                </h1>
                <div class="page-breadcrumb">
                    <a href="{{ path('dashboard') }}">Dashboard</a>
                    <span>/</span>
                    {% if cour is not null %}
                        <a href="{{ path('app_cours_index') }}">Cours</a>
                        <span>/</span>
                        <span>{{ cour.tittre }}</span>
                    {% else %}
                        <span>Chapitres</span>
                    {% endif %}
                </div>
            </div>
            <div class="navbar-right">
                <a href="{{ path('app_chapitre_new') }}" class="card-btn">
                    + Nouveau chapitre
                </a>
            </div>
        </nav>

        {% if cour is null %}
            <section>
                <form method="get" class="filter-row">
                    <input type="text" name="q" value="{{ search }}" placeholder="Rechercher par titre...">
                    <select name="dir">
                        <option value="">Tri par ordre</option>
                        <option value="ASC" {% if dir == 'ASC' %}selected{% endif %}>Ordre croissant</option>
                        <option value="DESC" {% if dir == 'DESC' %}selected{% endif %}>Ordre décroissant</option>
                    </select>
                    <button type="submit">Filtrer</button>
                </form>
            </section>
        {% endif %}

        <section>
            <table class="chapters-table">
                <thead>
                    <tr>
                        <th>ID Chapitre</th>
                        <th>Titre</th>
                        <th>Cours</th>
                        <th>Ordre</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for chapitre in chapitres %}
                    <tr>
                        <td>{{ chapitre.idChapitre }}</td>
                        <td>{{ chapitre.titre }}</td>
                        <td>
                            {% if chapitre.idCours %}
                                <span class="badge-small">
                                    {{ chapitre.idCours.tittre }}
                                </span>
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td>{{ chapitre.ordre }}</td>
                        <td>
                            <a href="{{ path('app_chapitre_show', {'id': chapitre.id}) }}" class="card-btn" style="font-size: 11px; padding: 4px 8px;">
                                Show
                            </a>
                            <a href="{{ path('app_chapitre_edit', {'id': chapitre.id}) }}" class="card-btn" style="font-size: 11px; padding: 4px 8px;">
                                Edit
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" style="color: #9ca3af; font-size: 13px; padding-top: 10px;">
                            Aucun chapitre trouvé.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </section>
    </main>
</div>

<button class="mobile-menu-toggle">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
</button>

<footer class="site-footer">
    <p>C
opyright © 2026 Your Company.
        Designed by <a href="https://templatemo.com" target="_blank" rel="nofollow">TemplateMo</a></p>
</footer>

<script src="{{ asset('js/templatemo-glass-admin-script.js') }}"></script>
</body>
</html>
