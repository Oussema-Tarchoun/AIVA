{# templates/chapitre/edit.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Chapitre - 3D Glassmorphism Dashboard</title>
    <meta name="description" content="3D Glassmorphism Dashboard Template by TemplateMo">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/templatemo-glass-admin-style.css') }}">

    <style>
        .modal-page {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 32px 16px;
        }
        .modal-card {
            max-width: 720px;
            width: 100%;
            border-radius: 24px;
            background: radial-gradient(circle at top left, rgba(59, 130, 246, 0.18), transparent 55%),
                        radial-gradient(circle at bottom right, rgba(16, 185, 129, 0.18), transparent 55%),
                        rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(148, 163, 184, 0.4);
            box-shadow: 0 28px 80px rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(18px);
            padding: 20px 22px 18px;
        }
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 12px;
        }
        .modal-title {
            font-size: 20px;
            font-weight: 600;
            color: #e5e7eb;
        }
        .modal-subtitle {
            font-size: 13px;
            color: #9ca3af;
        }
        .modal-close {
            border-radius: 999px;
            border: 1px solid rgba(148, 163, 184, 0.4);
            background: rgba(15, 23, 42, 0.9);
            color: #9ca3af;
            padding: 4px 10px;
            font-size: 12px;
            text-decoration: none;
        }
        .modal-close:hover {
            color: #e5e7eb;
            border-color: rgba(209, 213, 219, 0.8);
        }
        .modal-body {
            margin-top: 4px;
        }
        .modal-footer {
            margin-top: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }
        .link-muted {
            font-size: 12px;
            color: #9ca3af;
            text-decoration: none;
        }
        .link-muted:hover {
            color: #e5e7eb;
            text-decoration: underline;
        }
        .delete-inline {
            display: inline-block;
            margin-left: 8px;
        }
    </style>
</head>
<body>
    <!-- Animated Background -->
    <div class="background"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div class="dashboard">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <img src="{{ asset('images/logo.png') }}" alt="Logo" style="width: 50px; height: auto; margin-top: 12%;">
                </div>
                <span class="logo-text">GlassDash</span>
            </div>

            <ul class="nav-menu">
                <li class="nav-section">
                    <span class="nav-section-title">Main Menu</span>
                    <ul>
                        <li class="nav-item">
                            <a href="{{ path('app_chapitre_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_chapitre_' %}active{% endif %}">
                                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 4h16v4H4z"/><path d="M4 10h16v4H4z"/><path d="M4 16h16v4H4z"/>
                                </svg>
                                Chapitres
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_cours_index') }}" class="nav-link">
                                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 4h16v4H4z"/>
                                    <path d="M4 10h16v10H4z"/>
                                </svg>
                                Cours
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="nav-section">
                    <span class="nav-section-title">Account</span>
                    <ul>
                        <li class="nav-item">
                            <a href="{{ path('login') }}" class="nav-link">
                                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                    <polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                                </svg>
                                Logout
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>

            <div class="sidebar-footer">
                <div class="user-profile">
                    <div class="user-avatar">TM</div>
                    <div class="user-info">
                        <div class="user-name">TemplateMo</div>
                        <div class="user-role">Administrator</div>
                    </div>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content modal-page">
            <div class="modal-card">
                <div class="modal-header">
                    <div>
                        <div class="modal-title">Edit Chapitre</div>
                        <div class="modal-subtitle">Modify the chapter information.</div>
                    </div>
                    <a href="{{ path('app_chapitre_index') }}" class="modal-close">Close</a>
                </div>

                <div class="modal-body">
                    {{ include('chapitre/_form.html.twig', { button_label: 'Update' }) }}
                    <div style="margin-top: 12px;">
                        {{ include('chapitre/_delete_form.html.twig') }}
                    </div>
                </div>

                <div class="modal-footer">
                    <a href="{{ path('app_chapitre_index') }}" class="link-muted">
                        ← Back to chapters list
                    </a>
                </div>
            </div>
        </main>
    </div>

    <!-- Mobile Menu Toggle -->
    <button class="mobile-menu-toggle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
    </button>

    <!-- Footer -->
    <footer class="site-footer">
        <p>
            Copyright © 2026 Your Company.
            Designed by <a href="https://templatemo.com" target="_blank" rel="nofollow">TemplateMo</a>
        </p>
    </footer>

    <script src="{{ asset('js/templatemo-glass-admin-script.js') }}"></script>
</body>
</html>
