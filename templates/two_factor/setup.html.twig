{% extends 'base.html.twig' %}

{% block title %}Setup 2FA - AIVA{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0" style="border-radius: 20px; background: rgba(255,255,255,0.05); backdrop-filter: blur(10px); color: white;">
                <div class="card-header bg-transparent border-0 text-center pt-4">
                    <h2 class="fw-bold">Two-Factor Authentication Setup</h2>
                </div>
                <div class="card-body p-4">
                    <p class="text-white-50 text-center mb-4">
                        Protect your account by adding an extra layer of security. Scan the QR code below with your authenticator app.
                    </p>

                    <div class="text-center mb-4 p-3 bg-white rounded-3 d-inline-block mx-auto d-block" style="width: fit-content; border: 4px solid #00d4aa;">
                        <div id="qrcode-container">
                            <img id="qr-image" src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data={{ qrCodeContent|url_encode }}" 
                                 alt="QR Code" style="width: 250px; height: 250px; display: block; margin: 0 auto;">
                        </div>
                        <p class="text-dark mt-2 mb-0 small fw-bold">Scan with Google Authenticator</p>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-white-50 small">Manual Entry Key</label>
                        <div class="input-group">
                            <input type="text" class="form-control bg-dark border-secondary text-white" value="{{ secret }}" readonly>
                            <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText('{{ secret }}')">Copy</button>
                        </div>
                    </div>

                    <form action="{{ path('app_2fa_confirm') }}" method="POST">
                        <div class="mb-3">
                            <label for="code" class="form-label text-white">Enter 6-digit verification code</label>
                            <input type="text" name="code" id="code" class="form-control bg-dark border-secondary text-white form-control-lg text-center" placeholder="000000" maxlength="6" required autofocus>
                        </div>
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg" style="background: linear-gradient(135deg, #00d4aa, #a855f7); border: none; font-weight: bold; color: white;">
                                Activate 2FA
                            </button>
                            <a href="{{ path('app_profile') }}" class="btn btn-outline-light btn-sm mt-2" style="border-radius: 12px; opacity: 0.7;">
                                ← Back to Profile
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
