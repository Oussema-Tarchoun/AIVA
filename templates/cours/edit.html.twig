{# templates/cours/edit.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Cours - 3D Glassmorphism Dashboard</title>
    <meta name="description" content="3D Glassmorphism Dashboard Template by TemplateMo">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/templatemo-glass-admin-style.css') }}">

    <style>
        .modal-page {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 32px 16px;
        }
        .modal-card {
            max-width: 720px;
            width: 100%;
            border-radius: 24px;
            background: radial-gradient(circle at top left, rgba(59, 130, 246, 0.18), transparent 55%),
                        radial-gradient(circle at bottom right, rgba(16, 185, 129, 0.18), transparent 55%),
                        rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(148, 163, 184, 0.4);
            box-shadow: 0 28px 80px rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(18px);
            padding: 20px 22px 18px;
        }
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 12px;
        }
        .modal-title {
            font-size: 20px;
            font-weight: 600;
            color: #e5e7eb;
        }
        .modal-subtitle {
            font-size: 13px;
            color: #9ca3af;
        }
        .modal-close {
            border-radius: 999px;
            border: 1px solid rgba(148, 163, 184, 0.4);
            background: rgba(15, 23, 42, 0.9);
            color: #9ca3af;
            padding: 4px 10px;
            font-size: 12px;
            text-decoration: none;
        }
        .modal-close:hover {
            color: #e5e7eb;
            border-color: rgba(209, 213, 219, 0.8);
        }
        .modal-body {
            margin-top: 4px;
        }
        .modal-footer {
            margin-top: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }
        .link-muted {
            font-size: 12px;
            color: #9ca3af;
            text-decoration: none;
        }
        .link-muted:hover {
            color: #e5e7eb;
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <!-- Animated Background -->
    <div class="background"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div class="dashboard">
     <!-- Sidebar -->
<aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo">
            <img src="{{ asset('images/logo.png') }}" alt="Logo"
                 style="width: 80px; display: block; margin: 12px auto;">
        </div>
        <span class="logo-text">EnergyDash</span>
    </div>

    <ul class="nav-menu">

        {# Menu Principal #}
        <li class="nav-section">
            <span class="nav-section-title">Menu Principal</span>
            <ul>
                <li class="nav-item">
                    <a href="{{ path('dashboard') }}"
                       class="nav-link {% if app.request.attributes.get('_route') == 'dashboard' %}active{% endif %}">
                        <i class="fa-solid fa-house"></i> Tableau de bord
                    </a>
                </li>
            </ul>
        </li>

        {# Menu énergies #}
        <li class="nav-section">
            <span class="nav-section-title">Menu énergies</span>
            <ul>
                <li class="nav-item">
                    <a href="{{ path('energy') }}"
                       class="nav-link {% if app.request.attributes.get('_route') == 'energy' %}active{% endif %}">
                        <i class="fa-solid fa-bolt"></i> Consommation d'énergie
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('recommendations') }}"
                       class="nav-link {% if app.request.attributes.get('_route') == 'recommendations' %}active{% endif %}">
                        <i class="fa-solid fa-lightbulb"></i> Recommandations
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('stateenergi') }}"
                       class="nav-link {% if app.request.attributes.get('_route') == 'stateenergi' %}active{% endif %}">
                        <i class="fa-solid fa-chart-line"></i> Statistiques d'énergie
                    </a>
                </li>
            </ul>
        </li>

        {# ✅ Menu Nutrition (Aliments + Repas) #}
        <li class="nav-section">
            <span class="nav-section-title">Nutrition</span>
            <ul>
                <li class="nav-item">
                    <a href="{{ path('app_aliment_index') }}"
                       class="nav-link {% if app.request.attributes.get('_route') starts with 'app_aliment_' %}active{% endif %}">
                        <i class="fa-solid fa-apple-whole"></i> Aliments
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_repas_index') }}"
                       class="nav-link {% if app.request.attributes.get('_route') starts with 'repas_aliment_' %}active{% endif %}">
                        <i class="fa-solid fa-utensils"></i> Repas
                    </a>
                </li>
            </ul>
        </li>

        {# ✅ Menu Formation (Cours/Chapitres) #}
        <li class="nav-section">
            <span class="nav-section-title">Formation</span>
            <ul>
                <li class="nav-item">
                    <a href="{{ path('app_cours_index') }}"
                       class="nav-link {% if app.request.attributes.get('_route') starts with 'app_cours_' %}active{% endif %}">
                        <i class="fa-solid fa-book"></i> Cours
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_chapitre_index') }}"
                       class="nav-link {% if app.request.attributes.get('_route') starts with 'app_chapitre_' %}active{% endif %}">
                        <i class="fa-solid fa-list"></i> Chapitres
                    </a>
                </li>
            </ul>
        </li>

        {# Compte #}
        <li class="nav-section">
            <span class="nav-section-title">Compte</span>
            <ul>
                <li class="nav-item">
                    <a href="{{ path('app_profile') }}"
                       class="nav-link {% if app.request.attributes.get('_route') == 'app_profile' %}active{% endif %}">
                        <i class="fa-solid fa-user"></i> Profil
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_user_index') }}"
                       class="nav-link {% if app.request.attributes.get('_route') starts with 'app_user_' %}active{% endif %}">
                        <i class="fa-solid fa-users"></i> Users
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_logout') }}" class="nav-link">
                        <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
                    </a>
                </li>
            </ul>
        </li>

    </ul>
</aside>
        <!-- Main Content -->
        <main class="main-content modal-page">
            <div class="modal-card">
                <div class="modal-header">
                    <div>
                        <div class="modal-title">Edit Cours</div>
                        <div class="modal-subtitle">Modify the course information.</div>
                    </div>
                    <a href="{{ path('app_cours_index') }}" class="modal-close">Close</a>
                </div>

                <div class="modal-body">
                    {{ include('cours/_form.html.twig', { button_label: 'Update' }) }}
                    <div style="margin-top: 12px;">
                        {{ include('cours/_delete_form.html.twig') }}
                    </div>
                </div>

                <div class="modal-footer">
                    <a href="{{ path('app_cours_index') }}" class="link-muted">
                        ← Back to courses list
                    </a>
                </div>
            </div>
        </main>
    </div>

    <!-- Mobile Menu Toggle -->
    <button class="mobile-menu-toggle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
    </button>

    <!-- Footer -->
    <footer class="site-footer">
        <p>
            Copyright © 2026 Your Company.
            Designed by <a href="https://templatemo.com" target="_blank" rel="nofollow">TemplateMo</a>
        </p>
    </footer>

    <script src="{{ asset('js/templatemo-glass-admin-script.js') }}"></script>
</body>
</html>
