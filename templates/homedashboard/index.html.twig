{# templates/homedashboard/index.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - 3D Glassmorphism</title>
    <meta name="description" content="3D Glassmorphism Dashboard Template by TemplateMo">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/templatemo-glass-admin-style.css') }}">

    <style>
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 18px;
            margin-top: 18px;
        }
        .stat-card {
            border-radius: 18px;
            padding: 14px 16px;
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(148, 163, 184, 0.4);
            box-shadow: 0 18px 45px rgba(0, 0, 0, 0.55);
            backdrop-filter: blur(18px);
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .stat-label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #9ca3af;
        }
        .stat-value {
            font-size: 22px;
            font-weight: 600;
            color: #e5e7eb;
        }
        .stat-note {
            font-size: 11px;
            color: #9ca3af;
        }
        .two-column-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 18px;
            margin-top: 24px;
        }
        .mini-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }
        .mini-table th,
        .mini-table td {
            padding: 6px 8px;
            border-bottom: 1px solid rgba(31, 41, 55, 0.9);
        }
        .mini-table th {
            text-align: left;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #9ca3af;
        }
        .mini-table tbody tr:last-child td {
            border-bottom: none;
        }
        .badge-small {
            display: inline-block;
            padding: 2px 7px;
            border-radius: 999px;
            border: 1px solid rgba(148, 163, 184, 0.5);
            font-size: 10px;
            color: #e5e7eb;
        }
    </style>
</head>
<body>
<div class="background"></div>
<div class="orb orb-1"></div>
<div class="orb orb-2"></div>
<div class="orb orb-3"></div>

<div class="dashboard">
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <img src="{{ asset('images/logo.png') }}" alt="Logo" style="width: 50px; height: auto; margin-top: 12%;">
            </div>
            <span class="logo-text">GlassDash</span>
        </div>

        <ul class="nav-menu">
            <li class="nav-section">
                <span class="nav-section-title">Main Menu</span>
                <ul>
                    <li class="nav-item">
                        <a href="{{ path('homedashboard') }}"
                           class="nav-link {% if app.request.attributes.get('_route') == 'homedashboard' %}active{% endif %}">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 13h8V3H3zM13 21h8v-8h-8zM13 3v8h8V3zM3 21h8v-8H3z"/>
                            </svg>
                            Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_cours_index') }}"
                           class="nav-link {% if app.request.attributes.get('_route') starts with 'app_cours_' %}active{% endif %}">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16v4H4z"/>
                                <path d="M4 10h16v10H4z"/>
                            </svg>
                            Cours
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_chapitre_index') }}"
                           class="nav-link {% if app.request.attributes.get('_route') starts with 'app_chapitre_' %}active{% endif %}">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16v4H4z"/><path d="M4 10h16v4H4z"/><path d="M4 16h16v4H4z"/>
                            </svg>
                            Chapitres
                        </a>
                    </li>
                </ul>
            </li>

            <li class="nav-section">
                <span class="nav-section-title">Actions rapides</span>
                <ul>
                    <li class="nav-item">
                        <a href="{{ path('app_cours_new') }}" class="nav-link">
                            Nouveau cours
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_chapitre_new') }}" class="nav-link">
                            Nouveau chapitre
                        </a>
                    </li>
                </ul>
            </li>

            <li class="nav-section">
                <span class="nav-section-title">Account</span>
                <ul>
                    <li class="nav-item">
                        <a href="{{ path('login') }}" class="nav-link">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                <polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                            </svg>
                            Logout
                        </a>
                    </li>
                </ul>
            </li>
        </ul>

        <div class="sidebar-footer">
            <div class="user-profile">
                <div class="user-avatar">TM</div>
                <div class="user-info">
                    <div class="user-name">TemplateMo</div>
                    <div class="user-role">Administrator</div>
                </div>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <nav class="navbar">
            <div class="page-header">
                <h1 class="page-title">Dashboard</h1>
                <div class="page-breadcrumb">
                    <span>Overview</span>
                </div>
            </div>
        </nav>

        <!-- Stats cards -->
        <section class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Total cours</div>
                <div class="stat-value">{{ totalCours }}</div>
                <div class="stat-note">Tous les cours disponibles dans la plateforme.</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Total chapitres</div>
                <div class="stat-value">{{ totalChapitres }}</div>
                <div class="stat-note">Chapitres répartis dans vos cours.</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Chapitres / cours</div>
                <div class="stat-value">{{ averageChapitresPerCours }}</div>
                <div class="stat-note">Nombre moyen de chapitres par cours.</div>
            </div>
        </section>

        <!-- Last courses & chapters -->
        <section class="two-column-grid">
            <div class="glass-card">
                <div class="card-header">
                    <div>
                        <h2 class="card-title">Derniers cours</h2>
                        <p class="card-subtitle">3 cours les plus récents</p>
                    </div>
                    <div class="card-actions">
                        <a href="{{ path('app_cours_index') }}" class="card-btn">Voir tous</a>
                    </div>
                </div>
                <div class="card-body">
                    {% if lastCours is not empty %}
                        <table class="mini-table">
                            <thead>
                                <tr>
                                    <th>Titre</th>
                                    <th>Catégorie</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for cour in lastCours %}
                                    <tr>
                                        <td>
                                            <a href="{{ path('app_cours_show', { id: cour.id }) }}" style="color:#bfdbfe; text-decoration:none;">
                                                {{ cour.tittre }}
                                            </a>
                                        </td>
                                        <td>
                                            <span class="badge-small">{{ cour.categorie }}</span>
                                        </td>
                                        <td>{{ cour.dateCreation ? cour.dateCreation|date('Y-m-d') : '' }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p style="font-size: 12px; color: #9ca3af;">Aucun cours pour le moment.</p>
                    {% endif %}
                </div>
            </div>

            <div class="glass-card">
                <div class="card-header">
                    <div>
                        <h2 class="card-title">Derniers chapitres</h2>
                        <p class="card-subtitle">3 chapitres les plus récents</p>
                    </div>
                    <div class="card-actions">
                        <a href="{{ path('app_chapitre_index') }}" class="card-btn">Voir tous</a>
                    </div>
                </div>
                <div class="card-body">
                    {% if lastChapitres is not empty %}
                        <table class="mini-table">
                            <thead>
                                <tr>
                                    <th>Titre</th>
                                    <th>Cours</th>
                                    <th>Ordre</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for chapitre in lastChapitres %}
                                    <tr>
                                        <td>
                                            <a href="{{ path('app_chapitre_show', { id: chapitre.id }) }}" style="color:#bfdbfe; text-decoration:none;">
                                                {{ chapitre.titre }}
                                            </a>
                                        </td>
                                        <td>
                                            {% if chapitre.idCours %}
                                                <span class="badge-small">
                                                    {{ chapitre.idCours.tittre }}
                                                </span>
                                            {% else %}
                                                -
                                            {% endif %}
                                        </td>
                                        <td>{{ chapitre.ordre }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p style="font-size: 12px; color: #9ca3af;">Aucun chapitre pour le moment.</p>
                    {% endif %}
                </div>
            </div>
        </section>
    </main>
</div>

<button class="mobile-menu-toggle">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
</button>

<footer class="site-footer">
    <p>C
opyright © 2026 Your Company.
        Designed by <a href="https://templatemo.com" target="_blank" rel="nofollow">TemplateMo</a></p>
</footer>

<script src="{{ asset('js/templatemo-glass-admin-script.js') }}"></script>
</body>
</html>
