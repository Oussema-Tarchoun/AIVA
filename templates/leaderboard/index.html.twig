<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>AIVA Leaderboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/templatemo-glass-admin-style.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        .leaderboard-page {
            min-height: 100vh;
            padding: 60px 20px;
            position: relative;
            z-index: 10;
        }
        .leaderboard-container {
            max-width: 900px;
            margin: 0 auto;
            border-radius: 30px;
            border: 1px solid rgba(255,255,255,.12);
            background: rgba(255,255,255,.03);
            backdrop-filter: blur(20px);
            padding: 40px;
            box-shadow: 0 30px 100px rgba(0,0,0,.4);
        }
        .header-section {
            text-align: center;
            margin-bottom: 50px;
        }
        .header-section h1 {
            font-size: 3.5rem;
            font-weight: 900;
            margin-bottom: 10px;
            background: linear-gradient(to right, #fff, #00d4aa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .header-section p { opacity: 0.6; font-size: 1.1rem; }
        
        .leaderboard-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 12px;
        }
        .user-row {
            background: rgba(255,255,255,0.04);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 16px;
        }
        .user-row:hover {
            background: rgba(255,255,255,0.08);
            transform: scale(1.02);
            box-shadow: 0 10px 30px rgba(0,212,170,0.1);
        }
        .user-row td {
            padding: 20px;
            font-weight: 600;
        }
        .user-row td:first-child { border-radius: 16px 0 0 16px; }
        .user-row td:last-child { border-radius: 0 16px 16px 0; text-align: right; }
        
        .rank {
            font-size: 1.8rem;
            font-weight: 900;
            width: 60px;
            font-family: 'Space Mono', monospace;
        }
        .rank-1 { color: #FFD700; text-shadow: 0 0 15px rgba(255,215,0,0.5); }
        .rank-2 { color: #C0C0C0; }
        .rank-3 { color: #CD7F32; }
        
        .user-name { font-size: 1.1rem; }
        .user-level {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 8px;
            font-size: 0.75rem;
            text-transform: uppercase;
            font-weight: 900;
            margin-left: 10px;
        }
        .xp-count {
            color: #00d4aa;
            font-size: 1.2rem;
            font-weight: 700;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 20px;
            color: #00d4aa;
            text-decoration: none;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <div class="background"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div class="leaderboard-page">
        <div class="leaderboard-container">
            <a href="{{ path('app_profile') }}" class="back-link">
                <i class="fas fa-arrow-left"></i> Back to Profile
            </a>
            <div class="header-section">
                <h1>TOP RANKS</h1>
                <p>AIVA Performance Leaderboard</p>
            </div>

            <table class="leaderboard-table">
                <tbody>
                    {% for user in users %}
                        <tr class="user-row">
                            <td class="rank rank-{{ loop.index }}">
                                {{ loop.index }}
                            </td>
                            <td>
                                <span class="user-name">{{ user.name }}</span>
                                <span class="user-level" style="background: {{ user.levelColor }}; color: #000;">
                                    {{ user.levelName }}
                                </span>
                            </td>
                            <td class="xp-count">
                                {{ user.experiencePoints }} <span style="font-size: 0.8rem; opacity: 0.6;">XP</span>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
