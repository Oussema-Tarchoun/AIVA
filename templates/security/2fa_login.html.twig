{% extends 'base.html.twig' %}

{% block title %}2FA Verification - AIVA{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0" style="border-radius: 20px; background: rgba(255,255,255,0.05); backdrop-filter: blur(10px); color: white;">
                <div class="card-header bg-transparent border-0 text-center pt-5">
                    <div class="mb-3">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#00d4aa" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    </div>
                    <h2 class="fw-bold">Two-Factor Authentication</h2>
                    
                    <div class="text-center my-4 p-2 bg-white rounded-3 d-inline-block mx-auto" style="width: fit-content;">
                        {# Manually construct the QR code URL for the login page as a fallback/convenience #}
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data={{ ('otpauth://totp/AIVA:' ~ app.user.email ~ '?secret=' ~ app.user.totpSecret ~ '&issuer=AIVA')|url_encode }}" 
                             alt="QR Code" style="width: 150px; height: 150px; display: block;">
                    </div>

                    <p class="text-white-50 small">Scan the QR code if you haven't yet, then enter the code below.</p>
                </div>
                <div class="card-body p-4">
                    
                    {% if authentication_error is defined and authentication_error %}
                        <div class="alert alert-danger border-0 small py-2 mb-3" style="background: rgba(239,68,68,.15); color: #fecaca;">
                            {{ authentication_error|trans(authentication_error_data, 'SchebTwoFactorBundle') }}
                        </div>
                    {% endif %}

                    <form action="{{ check_path|default(path('2fa_login_check')) }}" method="post">
                        <div class="mb-4">
                            <label for="_auth_code" class="form-label text-white-50 small d-block text-center mb-2">6-Digit Verification Code</label>
                            <input type="text" 
                                   name="{{ code_parameter|default('_auth_code') }}" 
                                   id="_auth_code" 
                                   class="form-control bg-dark border-secondary text-white form-control-lg text-center" 
                                   placeholder="000 000" 
                                   maxlength="10" 
                                   required 
                                   autofocus 
                                   autocomplete="one-time-code">
                        </div>

                        {% if display_trusted_option is defined and display_trusted_option %}
                            <div class="mb-3 form-check small">
                                <input type="checkbox" name="{{ trusted_parameter|default('_trusted') }}" id="_trusted" class="form-check-input">
                                <label class="form-check-label text-white-70" for="_trusted">Keep me logged in for 30 days</label>
                            </div>
                        {% endif %}

                        <div class="d-grid gap-2">
                             <button type="submit" class="btn btn-primary btn-lg" style="background: linear-gradient(135deg, #00d4aa, #a855f7); border: none;">
                                Verify Code
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top border-secondary">
                        <a href="{{ path('app_logout') }}" class="btn btn-link text-white-50 text-decoration-none small">
                             <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                <polyline points="16 17 21 12 16 7"/>
                                <line x1="21" y1="12" x2="9" y2="12"/>
                            </svg>
                            Cancel and Logout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
