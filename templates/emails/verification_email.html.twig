<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Outfit', sans-serif; background-color: #0c0d12; color: #ffffff; margin: 0; padding: 0; }
        .container { max-width: 600px; margin: 40px auto; background-color: #161821; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); overflow: hidden; }
        .header { background: linear-gradient(135deg, #00d4aa, #a855f7); padding: 40px 20px; text-align: center; }
        .header h1 { color: #000; margin: 0; font-size: 28px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; }
        .content { padding: 40px; text-align: center; }
        .content p { font-size: 16px; line-height: 1.6; color: rgba(255,255,255,0.8); }
        .btn { display: inline-block; padding: 15px 35px; background-color: #00d4aa; color: #000; text-decoration: none; border-radius: 12px; font-weight: 800; margin-top: 20px; transition: 0.2s; }
        .footer { padding: 20px; text-align: center; font-size: 12px; color: rgba(255,255,255,0.4); border-top: 1px solid rgba(255,255,255,0.05); }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>AIVA SECURITY</h1>
        </div>
        <div class="content">
            <h2 style="margin-top: 0;">Verify Your Email</h2>
            <p>Hello <strong>{{ user.name }}</strong>,</p>
            <p>Welcome to AIVA! We're excited to have you on board. Please verify your email address to activate your account and access all features.</p>
            <a href="{{ url('app_verify_email', {token: user.verificationToken}) }}" class="btn">ACTIVATE ACCOUNT</a>
            <p style="margin-top: 30px; font-size: 13px;">This link will expire in 24 hours. If you did not register for an account, please ignore this email.</p>
        </div>
        <div class="footer">
            &copy; {{ "now"|date("Y") }} AIVA Management System. All rights reserved.
        </div>
    </div>
</body>
</html>
