                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        Users
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_logout') }}" class="nav-link">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                        Déconnexion
                    </a>
                </li>
            </ul>
        </li>

    </ul>

    <div class="sidebar-footer">
        <div class="user-profile">
            <div class="user-avatar">TM</div>
            <div class="user-info">
                <div class="user-name">TemplateMo</div>
                <div class="user-role">Administrator</div>
            </div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
            </svg>
        </div>
    </div>
</aside>

    <!-- Main Content -->
    <main class="main-content">
        <nav class="navbar">
            <div class="page-header">
                <h1 class="page-title">Détail catégorie</h1>
                <div class="page-breadcrumb">
                    <a href="{{ path('dashboard') }}">Dashboard</a>
                    <span>/</span>
                    <a href="{{ path('app_categorie_index') }}">Catégories</a>
                    <span>/</span>
                    <span>Détail</span>
                </div>
            </div>
        </nav>

        <section class="content-grid" style="grid-template-columns: 1fr;">
            <div class="glass-card" style="grid-column: span 1;">
                <div class="card-header">
                    <div>
                        <h2 class="card-title">Catégorie {{ categorie.nomCategorie }}</h2>
                        <p class="card-subtitle">Informations complètes sur cette catégorie</p>
                    </div>
                </div>

                <div class="card-body">
                    <table class="detail-table">
                        <tbody>
                        <tr>
                            <th>Id catégorie</th>
                            <td>{{ categorie.idCategorie }}</td>
                        </tr>
                        <tr>
                            <th>Nom</th>
                            <td>{{ categorie.nomCategorie }}</td>
                        </tr>
                        <tr>
                            <th>Description</th>
                            <td>{{ categorie.description }}</td>
                        </tr>
                        </tbody>
                    </table>

                    <div class="actions-row">
                        <a href="{{ path('app_categorie_index') }}" class="link-btn">
                            ← back to list
                        </a>

                        <a href="{{ path('app_categorie_edit', {'id': categorie.idCategorie}) }}" class="link-btn">
                            ✎ edit
                        </a>

                        {{ include('categorie/_delete_form.html.twig', { categorie: categorie }) }}
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

<button class="mobile-menu-toggle">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
</button>

<footer class="site-footer">
    <p>COPYRIGHT © 2026 Your Company. Designed by
        <a href="https://templatemo.com" target="_blank" rel="nofollow">TemplateMo</a>
    </p>
</footer>

<script src="{{ asset('js/templatemo-glass-admin-script.js') }}"></script>
