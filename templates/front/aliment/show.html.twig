<style>
  :root{
    --bg1:#0b1020;
    --bg2:#0b1b2b;
    --glass: rgba(255,255,255,.08);
    --glass2: rgba(255,255,255,.12);
    --border: rgba(255,255,255,.14);
    --text: rgba(255,255,255,.92);
    --muted: rgba(255,255,255,.70);
    --muted2: rgba(255,255,255,.55);
    --shadow: 0 18px 60px rgba(0,0,0,.45);
    --radius: 18px;
  }

  /* Layout wrapper helpers (if not already in your page) */
  body{
    margin:0;
    font-family: "Outfit", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    color: var(--text);
    background: radial-gradient(1200px 800px at 20% 10%, #1a3b6a 0%, transparent 60%),
                radial-gradient(900px 600px at 85% 20%, #3a1e65 0%, transparent 55%),
                linear-gradient(160deg, var(--bg1), var(--bg2));
    overflow-x:hidden;
  }

  /* HERO (same as your list page) */
  .hero{
    position: relative;
    background: var(--glass);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 8px);
    box-shadow: var(--shadow);
    padding: 34px 26px 26px;
    backdrop-filter: blur(14px);
    max-width: 1100px;
    margin: 44px auto 80px;
  }

  .glow{
    position:absolute;
    inset: -2px;
    border-radius: calc(var(--radius) + 10px);
    background: radial-gradient(800px 260px at 25% 10%, rgba(79,140,255,.22), transparent 60%),
                radial-gradient(700px 260px at 80% 20%, rgba(255,79,216,.18), transparent 60%);
    pointer-events:none;
    z-index:0;
  }
  .hero > *{ position:relative; z-index:1; }

  .hero-title{
    margin: 0 0 6px;
    font-size: 40px;
    letter-spacing: .2px;
  }
  .hero-title span{
    background: linear-gradient(90deg, #7fb0ff, #ff7ae6);
    -webkit-background-clip: text;
    background-clip:text;
    color: transparent;
  }

  .hero-description{
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 16px;
  }

  /* Card used in your snippet */
  .nutrition-card{
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.14);
    border-radius: var(--radius);
    padding: 18px;
    box-shadow: 0 18px 60px rgba(0,0,0,.18);
    backdrop-filter: blur(10px);
  }

  /* “Stats” section */
  .meal-details{
    display:grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .detail-box{
    background: rgba(0,0,0,.18);
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 16px;
    padding: 14px 14px 12px;
  }

  .detail-value{
    margin-top: 6px;
    font-weight: 800;
    letter-spacing: .2px;
    font-size: 18px;
    font-family: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .muted{
    color: var(--muted2);
    font-size: 12px;
    letter-spacing: .35px;
    text-transform: uppercase;
  }

  /* Notes box */
  .detail-note{
    margin-top: 14px;
    padding: 14px;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,.14);
    background: rgba(255,255,255,.06);
    color: rgba(255,255,255,.86);
    line-height: 1.55;
  }

  /* Foods grid */
  .foods-grid{
    display:grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .food-chip{
    display:flex;
    flex-direction:column;
    gap: 6px;
    padding: 12px 14px;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,.14);
    background: rgba(255,255,255,.06);
  }

  .food-chip strong{
    font-weight: 800;
    letter-spacing: .2px;
  }

  /* Chips (same as list page) */
  .chip{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding: 10px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.16);
    background: rgba(255,255,255,.08);
    color: var(--text);
    text-decoration:none;
    font-weight:600;
    font-size: 13px;
    transition: background .12s ease, transform .12s ease, border-color .12s ease;
    white-space:nowrap;
  }
  .chip:hover{
    transform: translateY(-1px);
    background: rgba(255,255,255,.12);
    border-color: rgba(255,255,255,.24);
  }
  .chip.active{
    background: linear-gradient(90deg, rgba(127,176,255,.22), rgba(255,122,230,.18));
    border-color: rgba(127,176,255,.35);
  }

  /* Responsive */
  @media (max-width: 980px){
    .meal-details{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .foods-grid{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px){
    .hero{ padding: 26px 18px; margin: 24px auto 60px; }
    .hero-title{ font-size: 32px; }
    .meal-details{ grid-template-columns: 1fr; }
    .foods-grid{ grid-template-columns: 1fr; }
  }
</style>
      <link rel="stylesheet" href="{{ asset('css/stylefront.css') }}">


