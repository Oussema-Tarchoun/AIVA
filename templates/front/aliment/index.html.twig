<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Foods - AIVA</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/templatemo-glass-admin-style.css') }}">
      <link rel="stylesheet" href="{{ asset('css/stylefront.css') }}">


  <style>
    :root{
      --bg1:#0b1020;
      --bg2:#0b1b2b;
      --glass: rgba(255,255,255,.08);
      --glass2: rgba(255,255,255,.12);
      --border: rgba(255,255,255,.14);
      --text: rgba(255,255,255,.92);
      --muted: rgba(255,255,255,.70);
      --muted2: rgba(255,255,255,.55);
      --shadow: 0 18px 60px rgba(0,0,0,.45);
      --radius: 18px;
    }

    *{ box-sizing:border-box; }
    html,body{ height:100%; }
    body{
      margin:0;
      font-family: "Outfit", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      color: var(--text);
      background: radial-gradient(1200px 800px at 20% 10%, #1a3b6a 0%, transparent 60%),
                  radial-gradient(900px 600px at 85% 20%, #3a1e65 0%, transparent 55%),
                  linear-gradient(160deg, var(--bg1), var(--bg2));
      overflow-x:hidden;
    }

    /* orbs */
    .orb{
      position: fixed;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      filter: blur(38px);
      opacity: .55;
      z-index: -1;
      animation: floaty 10s ease-in-out infinite;
    }
    .orb.one{ left:-140px; top:60px; background: #4f8cff; }
    .orb.two{ right:-160px; top:120px; background: #ff4fd8; animation-delay: -3s; }
    .orb.three{ left:40%; bottom:-200px; background: #3bffb8; animation-delay: -6s; }
    @keyframes floaty{
      0%,100%{ transform: translateY(0) translateX(0) scale(1); }
      50%{ transform: translateY(-24px) translateX(18px) scale(1.03); }
    }

    .wrap{
      max-width: 1100px;
      margin: 0 auto;
      padding: 44px 18px 80px;
    }

    .hero{
      position: relative;
      background: var(--glass);
      border: 1px solid var(--border);
      border-radius: calc(var(--radius) + 8px);
      box-shadow: var(--shadow);
      padding: 34px 26px 26px;
      backdrop-filter: blur(14px);
    }

    .glow{
      position:absolute;
      inset: -2px;
      border-radius: calc(var(--radius) + 10px);
      background: radial-gradient(800px 260px at 25% 10%, rgba(79,140,255,.22), transparent 60%),
                  radial-gradient(700px 260px at 80% 20%, rgba(255,79,216,.18), transparent 60%);
      pointer-events:none;
      z-index:0;
    }

    .hero > *{ position:relative; z-index:1; }

    .hero-title{
      margin: 0 0 6px;
      font-size: 40px;
      letter-spacing: .2px;
    }
    .hero-title span{
      background: linear-gradient(90deg, #7fb0ff, #ff7ae6);
      -webkit-background-clip: text;
      background-clip:text;
      color: transparent;
    }
    .hero-description{
      margin: 0 0 16px;
      color: var(--muted);
      font-size: 16px;
    }

    .top-actions{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      margin-top: 18px;
      margin-bottom: 16px;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      gap:10px;
      padding: 12px 16px;
      border-radius: 14px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,.08);
      color: var(--text);
      text-decoration:none;
      font-weight:600;
      transition: transform .12s ease, background .12s ease, border-color .12s ease;
    }
    .btn:hover{
      transform: translateY(-1px);
      background: rgba(255,255,255,.12);
      border-color: rgba(255,255,255,.22);
    }
    .btn .arrow{ opacity:.85; }

    .panel{
      margin-top: 16px;
      background: rgba(255,255,255,.06);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px;
    }

    .panel-head{
      display:flex;
      gap:14px;
      align-items:flex-end;
      justify-content:space-between;
      flex-wrap:wrap;
      margin-bottom: 14px;
    }

    .input-form{
      width: min(520px, 100%);
      margin: 0;
    }

    label{
      display:block;
      font-size: 12px;
      letter-spacing: .3px;
      color: var(--muted2);
      margin: 0 0 8px;
    }

    .search-row{
      display:flex;
      gap:10px;
      width:100%;
    }

    input[type="text"]{
      flex:1;
      height: 44px;
      padding: 10px 12px;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,.16);
      outline: none;
      background: rgba(0,0,0,.18);
      color: var(--text);
    }
    input[type="text"]::placeholder{ color: rgba(255,255,255,.45); }
    input[type="text"]:focus{
      border-color: rgba(127,176,255,.55);
      box-shadow: 0 0 0 3px rgba(127,176,255,.18);
    }

    .chip-row{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      justify-content:flex-end;
    }

    .chip{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding: 10px 12px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.16);
      background: rgba(255,255,255,.08);
      color: var(--text);
      text-decoration:none;
      font-weight:600;
      font-size: 13px;
      transition: background .12s ease, transform .12s ease, border-color .12s ease;
      white-space:nowrap;
    }
    .chip:hover{
      transform: translateY(-1px);
      background: rgba(255,255,255,.12);
      border-color: rgba(255,255,255,.24);
    }
    .chip.active{
      background: linear-gradient(90deg, rgba(127,176,255,.22), rgba(255,122,230,.18));
      border-color: rgba(127,176,255,.35);
    }
    .chip.danger{
      background: rgba(255, 90, 120, .16);
      border-color: rgba(255, 90, 120, .30);
    }

    .table-card{
      margin-top: 10px;
      overflow:hidden;
      border-radius: var(--radius);
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(0,0,0,.18);
    }

    table{
      width:100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    thead th{
      text-align:left;
      font-size: 12px;
      letter-spacing: .35px;
      color: rgba(255,255,255,.70);
      padding: 12px 14px;
      background: rgba(255,255,255,.06);
      border-bottom: 1px solid rgba(255,255,255,.10);
    }
    tbody td{
      padding: 12px 14px;
      border-bottom: 1px solid rgba(255,255,255,.08);
      vertical-align: middle;
    }
    tbody tr:hover{
      background: rgba(255,255,255,.05);
    }

    .muted{ color: var(--muted2); }
    .strong{ font-weight: 700; }

    .macro-row{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    }
    .macro-pill{
      display:inline-flex;
      padding: 7px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(255,255,255,.06);
      font-size: 12px;
      color: rgba(255,255,255,.85);
      font-family: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .actions{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    }

    /* small screens */
    @media (max-width: 740px){
      .hero-title{ font-size: 32px; }
      thead{ display:none; }
      table, tbody, tr, td{ display:block; width:100%; }
      tbody td{ border-bottom: none; padding: 10px 14px; }
      tbody tr{
        border-bottom: 1px solid rgba(255,255,255,.10);
      }
      tbody td::before{
        content: attr(data-label);
        display:block;
        color: rgba(255,255,255,.55);
        font-size: 12px;
        margin-bottom: 3px;
      }
    }
  </style>
</head>

<body>
 <!-- Navbar -->
  <nav class="navbar">
    <div class="logo">
      <svg width="32" height="32" viewBox="0 0 100 100">
        <defs>
          <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#a855f7" />
            <stop offset="50%" stop-color="#00d4aa" />
            <stop offset="100%" stop-color="#ec4899" />
          </linearGradient>
        </defs>
        <path d="M50 10 L85 80 L15 80 Z" fill="none" stroke="url(#grad)" stroke-width="4"/>
        <circle cx="50" cy="50" r="10" fill="#00d4aa"/>
      </svg>
      <span class="logo-text">AIVA</span>
    </div>

    <div class="nav-links">
            <a href="" class="active">Finance</a>
            <a href="">Learning</a>
                    <a href="{{ path('front_aliment_index') }}">Nutrition</a>

        <a href="{{ path('cours_front_index') }}">apprentissage</a>
        <a href="{{ path('front_energie_index') }}">Énergie</a>
    <a href="{{ path('front_recommandation_index') }}">Recommandation</a>

        </div>

  <a href="{{ path('app_logout') }}" class="nav-link">
                                <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
                            </a>  </nav>

  <div class="orb one"></div>
  <div class="orb two"></div>
  <div class="orb three"></div>

  <div class="wrap">
    <main class="hero">
      <div class="glow"></div>

      <h1 class="hero-title">Smart <span>Nutrition</span></h1>
      <p class="hero-description">Manage your foods and macros.</p>

      <div class="top-actions">
        <a class="btn" href="{{ path('front_aliment_new') }}">Add Food <span class="arrow">→</span></a>
        <a class="btn" href="{{ path('front_repas_index') }}">Meals <span class="arrow">→</span></a>
      </div>

      <section class="panel">
        <div class="panel-head">
          <form method="get" action="{{ path('front_aliment_index') }}" class="input-form">
            <label for="search">Search by name</label>
            <div class="search-row">
              <input id="search" type="text" name="search" value="{{ current_search }}" placeholder="Search by name...">
              <button class="btn" type="submit">Search <span class="arrow">→</span></button>
            </div>
          </form>

          <div class="chip-row">
            {% set nextOrderNom = (current_sort == 'nom' and current_order == 'ASC') ? 'DESC' : 'ASC' %}
            {% set nextOrderQty = (current_sort == 'quantite' and current_order == 'ASC') ? 'DESC' : 'ASC' %}

            <a class="chip {{ current_sort == 'nom' ? 'active' : '' }}"
               href="{{ path('front_aliment_index', {'sort':'nom','order':nextOrderNom,'search':current_search}) }}">
              Name {{ current_sort == 'nom' ? (current_order == 'ASC' ? '↑' : '↓') : '' }}
            </a>

            <a class="chip {{ current_sort == 'quantite' ? 'active' : '' }}"
               href="{{ path('front_aliment_index', {'sort':'quantite','order':nextOrderQty,'search':current_search}) }}">
              Quantity {{ current_sort == 'quantite' ? (current_order == 'ASC' ? '↑' : '↓') : '' }}
            </a>

            {% if current_search or current_sort or current_order %}
              <a class="chip danger" href="{{ path('front_aliment_index') }}">Reset</a>
            {% endif %}
          </div>
        </div>

        {% if aliments|length == 0 %}
          <p class="hero-description" style="margin: 0; padding: 10px 0;">No foods found.</p>
        {% else %}
          <div class="table-card">
            <table>
              <thead>
                <tr>
                  <th style="width:80px;">ID</th>
                  <th>Name</th>
                  <th style="width:140px;">Quantity</th>
                  <th style="width:320px;">Macros</th>
                  <th style="width:160px;">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for a in aliments %}
                  {% set m = a.macro ?? {} %}
                  <tr>
                    <td class="muted" data-label="ID">#{{ a.id }}</td>
                    <td class="strong" data-label="Name">{{ a.nom }}</td>
                    <td class="muted" data-label="Quantity">{{ a.quantite }}</td>
                    <td data-label="Macros">
                      <div class="macro-row">
                        <span class="macro-pill">P: {{ m.proteine|default(0) }}g</span>
                        <span class="macro-pill">G: {{ m.glucide|default(0) }}g</span>
                        <span class="macro-pill">L: {{ m.lipide|default(0) }}g</span>
                      </div>
                    </td>
                    <td data-label="Actions">
                      <div class="actions">
                        <a class="chip" href="{{ path('front_aliment_show', {'id': a.id}) }}">View</a>
                        <a class="chip active" href="{{ path('front_aliment_edit', {'id': a.id}) }}">Edit</a>
                      </div>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}
      </section>
    </main>
  </div>
</body>
</html>
