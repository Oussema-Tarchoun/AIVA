

{% block body %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/templatemo-glass-admin-style.css') }}">
<link rel="stylesheet" href="{{ asset('css/stylefront.css') }}">

<style>
  :root{
    --bg1:#0b1020;
    --bg2:#0b1b2b;
    --glass: rgba(255,255,255,.08);
    --glass2: rgba(255,255,255,.12);
    --border: rgba(255,255,255,.14);
    --text: rgba(255,255,255,.92);
    --muted: rgba(255,255,255,.70);
    --muted2: rgba(255,255,255,.55);
    --shadow: 0 18px 60px rgba(0,0,0,.45);
    --radius: 18px;
  }

  *{ box-sizing:border-box; }
  html,body{ height:100%; }
  body{
    margin:0;
    font-family: "Outfit", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    color: var(--text);
    background: radial-gradient(1200px 800px at 20% 10%, #1a3b6a 0%, transparent 60%),
                radial-gradient(900px 600px at 85% 20%, #3a1e65 0%, transparent 55%),
                linear-gradient(160deg, var(--bg1), var(--bg2));
    overflow-x:hidden;
  }

  .orb{
    position: fixed;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    filter: blur(38px);
    opacity: .55;
    z-index: -1;
    animation: floaty 10s ease-in-out infinite;
  }
  .orb.one{ left:-140px; top:60px; background: #4f8cff; }
  .orb.two{ right:-160px; top:120px; background: #ff4fd8; animation-delay: -3s; }
  .orb.three{ left:40%; bottom:-200px; background: #3bffb8; animation-delay: -6s; }
  @keyframes floaty{
    0%,100%{ transform: translateY(0) translateX(0) scale(1); }
    50%{ transform: translateY(-24px) translateX(18px) scale(1.03); }
  }

  .wrap{
    max-width: 1100px;
    margin: 0 auto;
    padding: 44px 18px 80px;
  }

  .hero{
    position: relative;
    background: var(--glass);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 8px);
    box-shadow: var(--shadow);
    padding: 34px 26px 26px;
    backdrop-filter: blur(14px);
  }

  .glow{
    position:absolute;
    inset: -2px;
    border-radius: calc(var(--radius) + 10px);
    background: radial-gradient(800px 260px at 25% 10%, rgba(79,140,255,.22), transparent 60%),
                radial-gradient(700px 260px at 80% 20%, rgba(255,79,216,.18), transparent 60%);
    pointer-events:none;
    z-index:0;
  }
  .hero > *{ position:relative; z-index:1; }

  .hero-title{
    margin: 0 0 6px;
    font-size: 40px;
    letter-spacing: .2px;
  }
  .hero-title span{
    background: linear-gradient(90deg, #7fb0ff, #ff7ae6);
    -webkit-background-clip: text;
    background-clip:text;
    color: transparent;
  }
  .hero-description{
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 16px;
  }

  .btn{
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding: 12px 16px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: rgba(255,255,255,.08);
    color: var(--text);
    text-decoration:none;
    font-weight:600;
    transition: transform .12s ease, background .12s ease, border-color .12s ease;
    cursor:pointer;
  }
  .btn:hover{
    transform: translateY(-1px);
    background: rgba(255,255,255,.12);
    border-color: rgba(255,255,255,.22);
  }

  .panel{
    margin-top: 16px;
    background: rgba(255,255,255,.06);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px;
  }

  label{
    display:block;
    font-size: 12px;
    letter-spacing: .3px;
    color: var(--muted2);
    margin: 14px 0 8px;
  }

  /* Inputs style (same as list page) */
  input[type="text"],
  input[type="number"],
  input[type="email"],
  input[type="password"],
  textarea,
  select{
    width: 100%;
    height: 44px;
    padding: 10px 12px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.16);
    outline: none;
    background: rgba(0,0,0,.18);
    color: var(--text);
  }
  textarea{ height: 120px; resize: vertical; }
  input:focus, textarea:focus, select:focus{
    border-color: rgba(127,176,255,.55);
    box-shadow: 0 0 0 3px rgba(127,176,255,.18);
  }

  .chip{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding: 10px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.16);
    background: rgba(255,255,255,.08);
    color: var(--text);
    text-decoration:none;
    font-weight:600;
    font-size: 13px;
    transition: background .12s ease, transform .12s ease, border-color .12s ease;
    white-space:nowrap;
  }
  .chip:hover{
    transform: translateY(-1px);
    background: rgba(255,255,255,.12);
    border-color: rgba(255,255,255,.24);
  }

  .macro-grid{
    display:grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 6px;
  }
  @media(max-width: 820px){
    .macro-grid{ grid-template-columns: 1fr; }
  }

  .actions-row{
    display:flex;
    gap:12px;
    justify-content:center;
    margin-top:20px;
    flex-wrap:wrap;
  }

  .danger{
    background: rgba(255, 90, 120, .16) !important;
    border-color: rgba(255, 90, 120, .30) !important;
    color: #ff6b86 !important;
  }
</style>

<!-- Navbar (same structure you have) -->
<nav class="navbar">
  <div class="logo">
    <svg width="32" height="32" viewBox="0 0 100 100">
      <defs>
        <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#a855f7" />
          <stop offset="50%" stop-color="#00d4aa" />
          <stop offset="100%" stop-color="#ec4899" />
        </linearGradient>
      </defs>
      <path d="M50 10 L85 80 L15 80 Z" fill="none" stroke="url(#grad)" stroke-width="4"/>
      <circle cx="50" cy="50" r="10" fill="#00d4aa"/>
    </svg>
    <span class="logo-text">AIVA</span>
  </div>

  <div class="nav-links">
  <a href="{{ path('front_categorie_index') }}">categorie</a>
<a href="{{ path('front_activite_index') }}">Activité</a>
    <a href="{{ path('front_objectif_index') }}">Objectif</a>
               <a href="{{ path('front_depense_index') }}">depense</a>            
<a href="{{ path('front_aliment_index') }}">Alimentation</a>
        <a href="{{ path('cours_front_index') }}">apprentissage</a>
        <a href="{{ path('front_energie_index') }}">Énergie</a>
    <a href="{{ path('front_recommandation_index') }}">Recommandation</a>

        </div>

  <a href="{{ path('app_logout') }}" class="nav-link">
                                <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
                            </a>  </nav>



<div class="orb one"></div>
<div class="orb two"></div>
<div class="orb three"></div>

<div class="wrap">
  <main class="hero">
    <div class="glow"></div>

    <h1 class="hero-title">Edit <span>{{ aliment.nom }}</span></h1>
    <p class="hero-description">Update your food data.</p>

    <section class="panel">
      {% set m = aliment.macro ?? {} %}

      {{ form_start(form) }}

        <label>Name</label>
        {{ form_widget(form.nom, {'attr': {'placeholder': 'Food name...'}}) }}
        {{ form_errors(form.nom) }}

        <label>Quantity (g)</label>
        {{ form_widget(form.quantite, {'attr': {'placeholder': 'Quantity...'}}) }}
        {{ form_errors(form.quantite) }}

        <div class="macro-grid">
          <div>
            <label>Proteine (g)</label>
            <input type="number" step="0.1" name="macro_proteine" value="{{ m.proteine|default(0) }}">
          </div>
          <div>
            <label>Glucide (g)</label>
            <input type="number" step="0.1" name="macro_glucide" value="{{ m.glucide|default(0) }}">
          </div>
          <div>
            <label>Lipide (g)</label>
            <input type="number" step="0.1" name="macro_lipide" value="{{ m.lipide|default(0) }}">
          </div>
        </div>

        <div class="actions-row">
          <button type="submit" class="btn">Update <span class="arrow">→</span></button>
          <a href="{{ path('front_aliment_index') }}" class="chip">Back</a>
        </div>

      {{ form_end(form) }}

      <div class="actions-row" style="margin-top: 14px;">
        {{ include('front/aliment/_delete_form.html.twig', {'aliment': aliment}) }}
      </div>
    </section>

  </main>
</div>
{% endblock %}
