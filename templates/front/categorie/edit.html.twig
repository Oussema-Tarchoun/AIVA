{% extends 'front/base_finance.html.twig' %}

{% block title %}Modifier une catégorie - AIVA{% endblock %}

{% block content %}
    <style>
        .btn-secondary {
            display: inline-block;
            padding: 10px 18px;
            border-radius: 10px;
            background: transparent;
            border: 1px solid #38bdf8;
            color: #38bdf8;
            font-weight: 600;
            text-decoration: none;
            transition: 0.3s;
            margin-left: 12px;
        }

        .btn-secondary:hover {
            background: #38bdf8;
            color: #0f172a;
        }

        .form-actions {
            margin-top: 20px;
            display: flex;
            gap: 12px;
            align-items: center;
        }
    </style>
<div class="form-card">
    <h1>Modifier une catégorie</h1>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        {{ form_widget(form) }}
        <div class="form-actions">
            <button type="submit" class="hero-button">Enregistrer les modifications</button>
<a href="{{ path('front_categorie_index') }}">← Retour à la page Finance</a>        </div>
    {{ form_end(form) }}
</div>
{% endblock %}