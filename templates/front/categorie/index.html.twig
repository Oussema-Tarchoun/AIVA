<script>
  (function () {
    const search = document.getElementById('catSearch');
    const dirBtn  = document.getElementById('catDir');
    const grid    = document.getElementById('categoriesGrid');
    if (!grid) return;

    const countShown = document.getElementById('catCountShown');
    let asc = true; // default: A → Z

    const getCards = () => Array.from(grid.querySelectorAll('.cat-card'));
    const normalize = (s) => (s || '').toString().toLowerCase().trim();

    function matches(card, q){
      if (!q) return true;
      // Search in name + description + id (still ok, sort only by name)
      const hay = [card.dataset.nom, card.dataset.description, card.dataset.id].join(' ');
      return hay.includes(q);
    }

    function apply(){
      const q = normalize(search.value);
      const cards = getCards();

      // filter
      cards.forEach(c => c.style.display = matches(c, q) ? '' : 'none');

      // sort visible only (BY NAME ONLY)
      const visible = cards.filter(c => c.style.display !== 'none');
      visible.sort((a,b) => {
        const base = (a.dataset.nom || '').localeCompare(b.dataset.nom || '');
        return asc ? base : -base;
      });

      visible.forEach(c => grid.appendChild(c));

      // count
      countShown.textContent = visible.length.toString();
    }

    dirBtn.addEventListener('click', () => {
      asc = !asc;
      dirBtn.innerHTML = asc
        ? '<i class="fa-solid fa-arrow-up-wide-short"></i>'
        : '<i class="fa-solid fa-arrow-down-wide-short"></i>';
      apply();
    });

    search.addEventListener('input', apply);

    apply();
  })();
</script>
