{% extends 'front/base_finance.html.twig' %}

{% block title %}Mes catégories - AIVA{% endblock %}

{% block content %}

<style>
    .btn-secondary {
        display: inline-block;
        padding: 10px 18px;
        border-radius: 10px;
        background: transparent;
        border: 1px solid #38bdf8;
        color: #38bdf8;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
    }

    .btn-secondary:hover {
        background: #38bdf8;
        color: #0f172a;
    }
</style>
<style>
    /* Table Card */
    .table-card {
        background: rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 0 20px rgba(0,0,0,0.2);
        overflow-x: auto;
    }

    /* Table */
    .aiva-table {
        width: 100%;
        border-collapse: collapse;
        color: #e2e8f0;
        font-size: 15px;
    }

    /* Header */
    .aiva-table thead {
        background: rgba(56, 189, 248, 0.15);
    }

    .aiva-table th {
        text-align: left;
        padding: 14px;
        font-weight: 700;
        color: #38bdf8;
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: 1px;
    }

    /* Rows */
    .aiva-table td {
        padding: 14px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .aiva-table tr:hover {
        background: rgba(56, 189, 248, 0.07);
        transition: 0.3s;
    }

    /* Strong cell */
    .cell-strong {
        font-weight: 700;
        color: white;
    }

    /* Actions */
    .actions {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    /* Buttons */
    .front-btn {
        padding: 6px 12px;
        border-radius: 10px;
        background: rgba(56,189,248,0.15);
        color: #38bdf8;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

    .front-btn:hover {
        background: #38bdf8;
        color: #0f172a;
    }

    .btn-link--edit {
        color: #facc15;
        font-weight: 600;
        text-decoration: none;
    }

    .btn-link--edit:hover {
        text-decoration: underline;
    }

    .btn-link--delete {
        color: #f87171;
        font-weight: 600;
        border: none;
        background: none;
        cursor: pointer;
    }

    .btn-link--delete:hover {
        text-decoration: underline;
    }

    /* Empty message */
    .front-empty {
        text-align: center;
        padding: 20px;
        color: rgba(226,232,240,0.7);
        font-style: italic;
    }
</style>
 
<div class="finance-panel">
    <div class="finance-panel-head">
        <div>
            <h1>Mes catégories</h1>
            <p>Gérez vos catégories de dépenses.</p>
        </div>
        <a href="{{ path('front_categorie_new') }}" class="hero-button">
            Ajouter une catégorie
        </a>
    </div>

    <div class="table-card">
        <table class="aiva-table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for categorie in categories %}
                    <tr>
                        <td class="cell-strong">{{ categorie.nomCategorie }}</td>
                        <td>{{ categorie.description }}</td>
                        <td>
                            <div class="actions">
                                <a href="{{ path('front_categorie_show', {id: categorie.idCategorie}) }}" class="front-btn">
                                    Voir
                                </a>

                                <a href="{{ path('front_categorie_edit', {id: categorie.idCategorie}) }}"
                                   class="btn-link btn-link--edit">
                                    Modifier
                                </a>

                                <form method="post"
                                      action="{{ path('front_categorie_delete', {'id': categorie.idCategorie}) }}"
                                      onsubmit="return confirm('Supprimer cette catégorie ?');">

                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete' ~ categorie.idCategorie) }}">

                                    <button type="submit" class="btn-link btn-link--delete">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="front-empty">
                            Aucune catégorie. Cliquez sur « Ajouter une catégorie » pour commencer.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Bouton Retour -->
    <p style="margin-top: 20px;">
        <a href="{{ path('front_categorie_index') }}">← Retour à la page Finance</a>
           
    </p>

</div>

{% endblock %}
