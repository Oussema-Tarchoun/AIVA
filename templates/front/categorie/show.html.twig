{% extends 'front/base_finance.html.twig' %}

{% block title %}Détail catégorie - AIVA{% endblock %}

{% block content %}

<style>
    .btn-secondary {
        display: inline-block;
        padding: 10px 18px;
        border-radius: 10px;
        background: transparent;
        border: 1px solid #38bdf8;
        color: #38bdf8;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
        margin-left: 10px;
    }

    .btn-secondary:hover {
        background: #38bdf8;
        color: #0f172a;
    }
</style>

<div class="form-card">
    <h1>Détail de la catégorie</h1>

    <ul style="list-style:none; padding:0; color:#e2e8f0;">
        <li style="margin-bottom:8px;">
            <strong>Nom :</strong> {{ categorie.nomCategorie }}
        </li>
        <li style="margin-bottom:8px;">
            <strong>Description :</strong> {{ categorie.description }}
        </li>
    </ul>

    <div class="form-actions">

        <!-- Bouton Modifier -->
        <a href="{{ path('front_categorie_edit', {id: categorie.idCategorie}) }}"
           class="hero-button"
           style="text-decoration:none;">
            Modifier
        </a>

        <!-- Bouton Retour -->
        <a href="{{ path('front_categorie_index') }}"
           class="btn-secondary">
            ← Retour
        </a>

    </div>
</div>

{% endblock %}
