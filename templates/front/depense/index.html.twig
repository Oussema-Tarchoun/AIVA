  <main class="hero">
    <div class="glow"></div>

    <h1 class="hero-title">💸 Mes Dépenses</h1>
    <p class="hero-description">Suivez vos dépenses, montants et catégories.</p>

    <!-- FLASH -->
    <div style="margin: 12px 0; width:100%; max-width:1100px; padding:0 60px; box-sizing:border-box;">
      {% for message in app.flashes('success') %}
        <div style="padding:10px;border-radius:8px;margin-bottom:8px;
                    background:rgba(0,210,150,.15);
                    border:1px solid rgba(0,210,150,.35);">
          {{ message }}
        </div>
      {% endfor %}
    </div>

    <!-- ANOMALIES BANNER -->
    {% if anomalies is defined and anomalies|length > 0 %}
    <div style="margin:0 0 12px; width:100%; max-width:1100px; padding:0 60px; box-sizing:border-box;">
      <div style="padding:14px 18px; border-radius:14px; background:rgba(239,68,68,.12); border:1px solid rgba(239,68,68,.35); color:#fecaca;">
        <strong><i class="fa-solid fa-triangle-exclamation"></i> Anomalies détectées !</strong>
        <ul style="margin:8px 0 0 18px; padding:0; font-size:13px;">
          {% for a in anomalies %}
            <li>
              <strong>{{ a.depense.description }}</strong> — {{ a.depense.montant }} TND
              ({{ a.depense.categorie ? a.depense.categorie.nomCategorie : '-' }})
              → <span style="color:#ff6b6b;">+{{ a.ecart }}%</span> au-dessus de la moyenne
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% endif %}

