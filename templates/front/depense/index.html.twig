<script>
  (function () {
    const search = document.getElementById('depenseSearch');
    const sortSel = document.getElementById('depenseSort');
    const dirBtn  = document.getElementById('depenseDir');
    const grid    = document.getElementById('depensesGrid');
    if (!grid) return;

    const countShown = document.getElementById('countShown');
    const totalShown = document.getElementById('totalShown');

    let asc = false; // default: newest/highest first

    const getCards = () => Array.from(grid.querySelectorAll('.depense-card'));

    const normalize = (s) => (s || '').toString().toLowerCase().trim();

    function matches(card, q){
      if (!q) return true;
      const hay = [
        card.dataset.id,
        card.dataset.description,
        card.dataset.statut,
        card.dataset.categorie,
        card.dataset.montant,
        card.dataset.date
      ].join(' ');
      return hay.includes(q);
    }

    function compare(a, b, key){
      const get = (el) => el.dataset[key] ?? '';
      if (key === 'montant'){
        const av = parseFloat(get(a)) || 0;
        const bv = parseFloat(get(b)) || 0;
        return av - bv;
      }
      if (key === 'date'){
        const av = get(a) || '';
        const bv = get(b) || '';
        return av.localeCompare(bv); // ISO yyyy-mm-dd
      }
      return 0;
    }

    function updateSummary(cards){
      const visible = cards.filter(c => c.style.display !== 'none');
      const total = visible.reduce((sum, c) => sum + (parseFloat(c.dataset.montant) || 0), 0);

      countShown.textContent = visible.length.toString();
      totalShown.textContent = total.toLocaleString('fr-FR', { maximumFractionDigits: 2 });
    }

    function apply(){
      const q = normalize(search.value);
      const sortKey = sortSel.value; // "date" or "montant"

      const cards = getCards();

      // filter (search stays)
      cards.forEach(c => {
        c.style.display = matches(c, q) ? '' : 'none';
      });

      // sort visible only
      const visible = cards.filter(c => c.style.display !== 'none');
      visible.sort((a,b) => {
        const key = (sortKey === 'montant') ? 'montant' : 'date';
        const base = compare(a, b, key);
        return asc ? base : -base;
      });

      visible.forEach(c => grid.appendChild(c));
      updateSummary(cards);
    }

    dirBtn.addEventListener('click', () => {
      asc = !asc;
      dirBtn.innerHTML = asc
        ? '<i class="fa-solid fa-arrow-up-wide-short"></i>'
        : '<i class="fa-solid fa-arrow-down-wide-short"></i>';
      apply();
    });

    search.addEventListener('input', apply);
    sortSel.addEventListener('change', apply);

    // initial
    apply();
  })();
</script>

