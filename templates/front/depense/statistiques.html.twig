{# templates/front/depense/statistiques.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Statistiques Dépenses - AIVA</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ asset('css/stylefront.css') }}">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
  <style>
    body, html { margin:0; padding:0; font-family:'Inter',system-ui,sans-serif; background:#0a0a12; color:#fff; min-height:100vh; }
    .container { width:100%; }

    .navbar { display:flex; justify-content:space-between; align-items:center; padding:20px 60px; border-bottom:1px solid #1a1a2e; position:sticky; top:0; z-index:20; background:rgba(10,10,18,.75); backdrop-filter:blur(10px); }
    .logo { display:flex; align-items:center; gap:12px; }
    .logo-text { font-size:20px; font-weight:bold; }
    .nav-links a { color:#888; text-decoration:none; font-size:14px; margin-left:40px; }
    .nav-links a.active { color:#00d4aa; }
    .nav-link { color:#c7c7c7; text-decoration:none; font-size:14px; display:inline-flex; gap:10px; align-items:center; }

    .hero { display:flex; flex-direction:column; align-items:center; text-align:center; padding-top:35px; padding-bottom:60px; position:relative; }
    .glow { position:absolute; top:10%; left:50%; transform:translateX(-50%); width:560px; height:340px; background:radial-gradient(ellipse,rgba(0,212,170,.15) 0%,transparent 70%); pointer-events:none; }
    .hero-title { font-size:40px; font-weight:800; margin-bottom:10px; }
    .hero-description { color:#888; font-size:16px; max-width:640px; margin-bottom:26px; }

    .stats-grid { width:100%; max-width:1100px; padding:0 60px; box-sizing:border-box; display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:30px; }
    .stat-card { padding:22px; border-radius:18px; border:1px solid rgba(255,255,255,.12); background:linear-gradient(135deg,rgba(255,255,255,.06),rgba(255,255,255,.02)); backdrop-filter:blur(10px); text-align:center; }
    .stat-value { font-size:32px; font-weight:800; color:#00d4aa; }
    .stat-label { font-size:13px; color:#888; margin-top:6px; }

    .charts-grid { width:100%; max-width:1100px; padding:0 60px; box-sizing:border-box; display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:40px; }
    .chart-card { padding:24px; border-radius:18px; border:1px solid rgba(255,255,255,.12); background:linear-gradient(135deg,rgba(255,255,255,.06),rgba(255,255,255,.02)); backdrop-filter:blur(10px); }
    .chart-card h3 { margin:0 0 16px; font-size:16px; font-weight:700; }
    .chart-card canvas { max-height:320px; }

    .btn { border:none; border-radius:999px; padding:10px 16px; font-size:13px; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; gap:8px; text-decoration:none; }
    .btn-secondary { background:transparent; border:1px solid #1a1a2e; color:#c7c7c7; }
    .btn:hover { opacity:.92; }

    @media(max-width:900px){ .stats-grid,.charts-grid{ grid-template-columns:1fr; padding:0 20px; } .navbar{padding:18px 20px;} }
  </style>
</head>
<body>
<div class="container">
  <nav class="navbar">
    <div class="logo">
      <svg width="32" height="32" viewBox="0 0 100 100">
        <defs><linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#a855f7"/><stop offset="50%" stop-color="#00d4aa"/><stop offset="100%" stop-color="#ec4899"/></linearGradient></defs>
        <path d="M50 10 L85 80 L15 80 Z" fill="none" stroke="url(#grad)" stroke-width="4"/>
        <circle cx="50" cy="50" r="10" fill="#00d4aa"/>
      </svg>
      <span class="logo-text">AIVA</span>
    </div>
    <div class="nav-links">
      <a href="{{ path('front_categorie_index') }}">Categorie</a>
      <a href="{{ path('front_activite_index') }}">Activité</a>
      <a href="{{ path('front_objectif_index') }}">Objectif</a>
      <a href="{{ path('front_depense_index') }}" class="active">Dépense</a>
      <a href="{{ path('front_aliment_index') }}">Alimentation</a>
      <a href="{{ path('cours_front_index') }}">Apprentissage</a>
      <a href="{{ path('front_energie_index') }}">Énergie</a>
      <a href="{{ path('front_recommandation_index') }}">Recommandations</a>
    </div>
    <a href="{{ path('app_logout') }}" class="nav-link"><i class="fa-solid fa-right-from-bracket"></i> Déconnexion</a>
  </nav>

  <main class="hero">
    <div class="glow"></div>
    <h1 class="hero-title">📊 Statistiques Dépenses</h1>
    <p class="hero-description">Vue d'ensemble de vos dépenses par catégorie et par mois.</p>

    <div style="margin-bottom:20px;">
      <a class="btn btn-secondary" href="{{ path('front_depense_index') }}"><i class="fa-solid fa-arrow-left"></i> Retour aux dépenses</a>
    </div>

    <!-- Summary cards -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-value">{{ totalGeneral|number_format(2, ',', ' ') }} TND</div>
        <div class="stat-label">Total général</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{{ parCategorie|length }}</div>
        <div class="stat-label">Catégories</div>
      </div>
      <div class="stat-card">
        {% set avg = parCategorie|length > 0 ? totalGeneral / parCategorie|length : 0 %}
        <div class="stat-value">{{ avg|number_format(2, ',', ' ') }} TND</div>
        <div class="stat-label">Moyenne par catégorie</div>
      </div>
    </div>

    <!-- Charts -->
    <div class="charts-grid">
      <div class="chart-card">
        <h3><i class="fa-solid fa-chart-pie"></i> Répartition par catégorie</h3>
        <canvas id="doughnutChart"></canvas>
      </div>
      <div class="chart-card">
        <h3><i class="fa-solid fa-chart-bar"></i> Évolution mensuelle</h3>
        <canvas id="barChart"></canvas>
      </div>
    </div>
  </main>
</div>

<script>
  const colors = ['#00d4aa','#a855f7','#ec4899','#f59e0b','#3b82f6','#ef4444','#10b981','#8b5cf6','#f97316','#06b6d4'];

  // Doughnut
  new Chart(document.getElementById('doughnutChart'), {
    type: 'doughnut',
    data: {
      labels: {{ parCategorie|map(c => c.nom)|json_encode|raw }},
      datasets: [{
        data: {{ parCategorie|map(c => c.total)|json_encode|raw }},
        backgroundColor: colors.slice(0, {{ parCategorie|length }}),
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { position:'bottom', labels:{ color:'#ccc', padding:14, font:{size:12} } }
      }
    }
  });

  // Bar
  new Chart(document.getElementById('barChart'), {
    type: 'bar',
    data: {
      labels: {{ parMois|map(m => m.mois)|json_encode|raw }},
      datasets: [{
        label: 'Total (TND)',
        data: {{ parMois|map(m => m.total)|json_encode|raw }},
        backgroundColor: 'rgba(0,212,170,.6)',
        borderColor: '#00d4aa',
        borderWidth: 1,
        borderRadius: 6
      }]
    },
    options: {
      responsive: true,
      scales: {
        y: { beginAtZero:true, ticks:{ color:'#888' }, grid:{ color:'rgba(255,255,255,.06)' } },
        x: { ticks:{ color:'#888' }, grid:{ display:false } }
      },
      plugins: { legend:{ display:false } }
    }
  });
</script>
</body>
</html>
