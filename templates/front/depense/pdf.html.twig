<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Helvetica, Arial, sans-serif; color: #1a1a2e; font-size: 12px; padding: 30px; }
    .header { text-align: center; margin-bottom: 30px; border-bottom: 3px solid #0d9488; padding-bottom: 15px; }
    .header h1 { font-size: 22px; color: #0d9488; margin-bottom: 4px; }
    .header p { color: #666; font-size: 11px; }
    table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    th { background: #0d9488; color: #fff; padding: 10px 8px; text-align: left; font-size: 11px; text-transform: uppercase; }
    td { padding: 9px 8px; border-bottom: 1px solid #e5e5e5; font-size: 11px; }
    tr:nth-child(even) td { background: #f8f8f8; }
    .total-row { margin-top: 20px; text-align: right; font-size: 16px; font-weight: bold; color: #0d9488; }
    .footer { margin-top: 30px; text-align: center; color: #999; font-size: 10px; border-top: 1px solid #ddd; padding-top: 10px; }
  </style>
</head>
<body>
  <div class="header">
    <h1>AIVA - Rapport des Dépenses</h1>
    <p>Généré le {{ date|date('d/m/Y à H:i') }}</p>
  </div>

  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Description</th>
        <th>Montant</th>
        <th>Date</th>
        <th>Catégorie</th>
        <th>Statut</th>
      </tr>
    </thead>
    <tbody>
      {% for depense in depenses %}
      <tr>
        <td>{{ depense.idDepense }}</td>
        <td>{{ depense.description }}</td>
        <td>{{ depense.montant }} TND</td>
        <td>{{ depense.dateDepense ? depense.dateDepense|date('d/m/Y') : '-' }}</td>
        <td>{{ depense.categorie ? depense.categorie.nomCategorie : '-' }}</td>
        <td>{{ depense.statut }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="total-row">
    Total : {{ total|number_format(2, ',', ' ') }} TND
  </div>

  <div class="footer">
    AIVA - Gestion de la vie étudiante &bull; Document généré automatiquement
  </div>
</body>
</html>
