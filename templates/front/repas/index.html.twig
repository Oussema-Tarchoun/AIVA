<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Meals - AIVA</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg1:#0b1020;
      --bg2:#0b1b2b;
      --glass: rgba(255,255,255,.08);
      --border: rgba(255,255,255,.14);
      --text: rgba(255,255,255,.92);
      --muted: rgba(255,255,255,.70);
      --muted2: rgba(255,255,255,.55);
      --shadow: 0 18px 60px rgba(0,0,0,.45);
      --radius: 18px;
    }
    *{ box-sizing:border-box; }
    html,body{ height:100%; }
    body{
      margin:0;
      font-family:"Outfit", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      color:var(--text);
      background: radial-gradient(1200px 800px at 20% 10%, #1a3b6a 0%, transparent 60%),
                  radial-gradient(900px 600px at 85% 20%, #3a1e65 0%, transparent 55%),
                  linear-gradient(160deg, var(--bg1), var(--bg2));
      overflow-x:hidden;
    }

    .orb{
      position: fixed;
      width: 420px; height: 420px;
      border-radius: 50%;
      filter: blur(38px);
      opacity: .55;
      z-index: -1;
      animation: floaty 10s ease-in-out infinite;
    }
    .orb.one{ left:-140px; top:60px; background:#4f8cff; }
    .orb.two{ right:-160px; top:120px; background:#ff4fd8; animation-delay:-3s; }
    .orb.three{ left:40%; bottom:-200px; background:#3bffb8; animation-delay:-6s; }
    @keyframes floaty{
      0%,100%{ transform: translateY(0) translateX(0) scale(1); }
      50%{ transform: translateY(-24px) translateX(18px) scale(1.03); }
    }

    .wrap{ max-width: 1100px; margin:0 auto; padding: 44px 18px 80px; }

    .hero{
      position: relative;
      background: var(--glass);
      border: 1px solid var(--border);
      border-radius: calc(var(--radius) + 8px);
      box-shadow: var(--shadow);
      padding: 34px 26px 26px;
      backdrop-filter: blur(14px);
    }
    .glow{
      position:absolute; inset:-2px;
      border-radius: calc(var(--radius) + 10px);
      background: radial-gradient(800px 260px at 25% 10%, rgba(79,140,255,.22), transparent 60%),
                  radial-gradient(700px 260px at 80% 20%, rgba(255,79,216,.18), transparent 60%);
      pointer-events:none; z-index:0;
    }
    .hero > *{ position:relative; z-index:1; }

    .hero-title{ margin:0 0 6px; font-size:40px; letter-spacing:.2px; }
    .hero-title span{
      background: linear-gradient(90deg, #7fb0ff, #ff7ae6);
      -webkit-background-clip:text; background-clip:text; color:transparent;
    }
    .hero-description{ margin:0 0 16px; color:var(--muted); font-size:16px; }

    .top-actions{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      margin-top: 18px;
      margin-bottom: 16px;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      gap:10px;
      padding: 12px 16px;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,.16);
      background: rgba(255,255,255,.08);
      color: var(--text);
      text-decoration:none;
      font-weight:700;
      cursor:pointer;
      transition: transform .12s ease, background .12s ease, border-color .12s ease;
      white-space:nowrap;
    }
    .btn:hover{
      transform: translateY(-1px);
      background: rgba(255,255,255,.12);
      border-color: rgba(255,255,255,.24);
    }

    .panel{
      margin-top: 16px;
      background: rgba(255,255,255,.06);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px;
    }

    .panel-head{
      display:flex;
      gap:14px;
      align-items:flex-end;
      justify-content:space-between;
      flex-wrap:wrap;
      margin-bottom: 14px;
    }

    .input-form{ width: min(520px, 100%); margin: 0; }
    label{
      display:block;
      font-size: 12px;
      letter-spacing: .3px;
      color: var(--muted2);
      margin: 0 0 8px;
    }
    .search-row{ display:flex; gap:10px; width:100%; }

    input[type="text"]{
      flex:1;
      height: 44px;
      padding: 10px 12px;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,.16);
      outline: none;
      background: rgba(0,0,0,.18);
      color: var(--text);
    }
    input[type="text"]::placeholder{ color: rgba(255,255,255,.45); }
    input[type="text"]:focus{
      border-color: rgba(127,176,255,.55);
      box-shadow: 0 0 0 3px rgba(127,176,255,.18);
    }

    .chip-row{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      justify-content:flex-end;
    }

    .chip{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding: 10px 12px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.16);
      background: rgba(255,255,255,.08);
      color: var(--text);
      text-decoration:none;
      font-weight:700;
      font-size: 13px;
      transition: background .12s ease, transform .12s ease, border-color .12s ease;
      white-space:nowrap;
    }
    .chip:hover{
      transform: translateY(-1px);
      background: rgba(255,255,255,.12);
      border-color: rgba(255,255,255,.24);
    }
    .chip.active{
      background: linear-gradient(90deg, rgba(127,176,255,.22), rgba(255,122,230,.18));
      border-color: rgba(127,176,255,.35);
    }
    .chip.danger{
      background: rgba(255, 90, 120, .16);
      border-color: rgba(255, 90, 120, .30);
    }

    .table-card{
      margin-top: 10px;
      overflow:hidden;
      border-radius: var(--radius);
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(0,0,0,.18);
    }

    table{
      width:100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    thead th{
      text-align:left;
      font-size: 12px;
      letter-spacing: .35px;
      color: rgba(255,255,255,.70);
      padding: 12px 14px;
      background: rgba(255,255,255,.06);
      border-bottom: 1px solid rgba(255,255,255,.10);
    }
    tbody td{
      padding: 12px 14px;
      border-bottom: 1px solid rgba(255,255,255,.08);
      vertical-align: middle;
    }
    tbody tr:hover{ background: rgba(255,255,255,.05); }

    .muted{ color: var(--muted2); }
    .strong{ font-weight: 800; }

    .cal-pill{
      display:inline-flex;
      padding: 7px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(255,255,255,.06);
      font-size: 12px;
      font-family: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      color: rgba(255,255,255,.88);
    }

    .actions{ display:flex; gap:8px; flex-wrap:wrap; }

    @media (max-width: 740px){
      .hero-title{ font-size: 32px; }
      thead{ display:none; }
      table, tbody, tr, td{ display:block; width:100%; }
      tbody td{ border-bottom: none; padding: 10px 14px; }
      tbody tr{ border-bottom: 1px solid rgba(255,255,255,.10); }
      tbody td::before{
        content: attr(data-label);
        display:block;
        color: rgba(255,255,255,.55);
        font-size: 12px;
        margin-bottom: 3px;
      }
    }
  </style>
</head>

<body>
  <div class="orb one"></div>
  <div class="orb two"></div>
  <div class="orb three"></div>

  <div class="wrap">
    <main class="hero">
      <div class="glow"></div>

      <h1 class="hero-title">Smart <span>Nutrition</span></h1>
      <p class="hero-description">Monitor your meals and calories.</p>

      <div class="top-actions">
        <a class="btn" href="{{ path('front_repas_new') }}">Add Meal <span>→</span></a>
        <a class="btn" href="{{ path('front_aliment_index') }}">Aliments <span>→</span></a>
      </div>

      <section class="panel">
        <div class="panel-head">
          <form method="get" action="{{ path('front_repas_index') }}" class="input-form">
            <label for="search">Search by name</label>
            <div class="search-row">
              <input id="search" type="text" name="search" value="{{ searchNom }}" placeholder="Search by name...">
              {% if sortCalories %}
                <input type="hidden" name="sort" value="{{ sortCalories }}">
              {% endif %}
              <button class="btn" type="submit">Search <span>→</span></button>
            </div>
          </form>

          <div class="chip-row">
            <a class="chip {{ sortCalories == 'asc' ? 'active' : '' }}"
               href="{{ path('front_repas_index', {'sort':'asc','search':searchNom}) }}">Calories ↑</a>
            <a class="chip {{ sortCalories == 'desc' ? 'active' : '' }}"
               href="{{ path('front_repas_index', {'sort':'desc','search':searchNom}) }}">Calories ↓</a>
            {% if searchNom or sortCalories %}
              <a class="chip danger" href="{{ path('front_repas_index') }}">Reset</a>
            {% endif %}
          </div>
        </div>

        {% if repas|length == 0 %}
          <p class="hero-description" style="margin: 0; padding: 10px 0;">No meals found.</p>
        {% else %}
          <div class="table-card">
            <table>
              <thead>
                <tr>
                  <th style="width:80px;">ID</th>
                  <th>Name</th>
                  <th style="width:160px;">Type</th>
                  <th style="width:110px;">Time</th>
                  <th style="width:140px;">Calories</th>
                  <th style="width:160px;">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for r in repas %}
                  <tr>
                    <td class="muted" data-label="ID">#{{ r.id }}</td>
                    <td class="strong" data-label="Name">{{ r.nom }}</td>
                    <td class="muted" data-label="Type">{{ r.type|replace({'-':' '})|title }}</td>
                    <td class="muted" data-label="Time">{{ r.heure ? r.heure|date('H:i') : 'N/A' }}</td>
                    <td data-label="Calories"><span class="cal-pill">{{ r.calories }} kcal</span></td>
                    <td data-label="Actions">
                      <div class="actions">
                        <a class="chip" href="{{ path('front_repas_show', {'id': r.id}) }}">View</a>
                        <a class="chip active" href="{{ path('front_repas_edit', {'id': r.id}) }}">Edit</a>
                      </div>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}
      </section>
    </main>
  </div>
</body>
</html>
