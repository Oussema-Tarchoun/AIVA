<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recommandations - AIVA</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ asset('css/stylefront.css') }}">
</head>

<body>
{% set recommandations = recommandations|default([]) %}
{% set energies = energies|default([]) %}

<div class="container">
  <nav class="navbar">
    <div class="logo">
      <svg width="32" height="32" viewBox="0 0 100 100">
        <defs>
          <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#a855f7" />
            <stop offset="50%" stop-color="#00d4aa" />
            <stop offset="100%" stop-color="#ec4899" />
          </linearGradient>
        </defs>
        <path d="M50 10 L85 80 L15 80 Z" fill="none" stroke="url(#grad)" stroke-width="4"/>
        <circle cx="50" cy="50" r="10" fill="#00d4aa"/>
      </svg>
      <span class="logo-text">AIVA</span>
    </div>

    <div class="nav-links">
      <a href="{{ path('front_energie_index') }}">Energy</a>
      <a href="{{ path('front_recommandation_index') }}" class="active">Recommandations</a>
    </div>

    <button class="get-started">Get Started</button>
  </nav>

  <main class="hero">
    <div class="glow"></div>
    <h1 class="hero-title">Recommandations</h1>
    <p class="hero-description">Generate and manage recommendations linked to your energies.</p>

    <div class="section-head">
      <h2 class="section-title">Mes recommandations</h2>
      <button class="btn btn-primary" type="button" id="openAddRecoModal">+ Ajouter</button>
    </div>

    <div class="table-wrap">
      <table class="aiva-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Titre</th>
            <th>Impact</th>
            <th>Date</th>
            <th>Énergie liée</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>

        <tbody>
        {% for r in recommandations %}
          <tr>
            <td>{{ r.id }}</td>
            <td>{{ r.titre }}</td>
            <td>{{ r.niveauImpact }}</td>
            <td>{{ r.dateGeneration ? r.dateGeneration|date('Y-m-d') : '' }}</td>
            <td>
              {# afficher type energie si tu veux #}
              {{ r.energie ? r.energie.typeEnergie : '' }}
            </td>

            <td class="text-right">
              <button
                type="button"
                class="btn btn-warning openEditRecoModal"
                data-id="{{ r.id }}"
                data-titre="{{ r.titre|e('html_attr') }}"
                data-description="{{ r.description|e('html_attr') }}"
                data-impact="{{ r.niveauImpact|e('html_attr') }}"
                data-date="{{ r.dateGeneration ? r.dateGeneration|date('Y-m-d') : '' }}"
                data-energie="{{ r.energie ? r.energie.id : '' }}"
              >
                Modifier
              </button>

              <form method="post"
                    action="{{ path('front_recommandation_delete', {id: r.id}) }}"
                    class="inline-form"
                    onsubmit="return confirm('Supprimer cette recommandation ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_reco_' ~ r.id) }}">
                <button class="btn btn-danger" type="submit">Supprimer</button>
              </form>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="6" class="empty-row">Aucune recommandation.</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>

  </main>
</div>

{# ================= MODAL ADD ================= #}
<div class="modal" id="recoAddModal" aria-hidden="true">
  <div class="modal-backdrop" data-close="1"></div>

  <div class="modal-dialog" role="dialog" aria-modal="true">
    <div class="modal-header">
      <h3 class="modal-title">Ajouter une recommandation</h3>
      <button class="modal-close" type="button" data-close="1">✕</button>
    </div>

    <div class="modal-body">
      <form method="POST" action="{{ path('front_recommandation_add') }}">
        <div class="form-grid">

          <div class="form-col">
            <label>Énergie liée</label>
            <select name="energie_id" required>
              <option value="">-- choisir --</option>
              {% for e in energies %}
                <option value="{{ e.id }}">{{ e.typeEnergie }} ({{ e.dateEnregistrement ? e.dateEnregistrement|date('Y-m-d') : '' }})</option>
              {% endfor %}
            </select>
          </div>

          <div class="form-col">
            <label>Date de génération</label>
            <input type="date" name="date_generation">
          </div>

          <div class="form-col-full">
            <label>Titre</label>
            <input type="text" name="titre" required>
          </div>

          <div class="form-col-full">
            <label>Description</label>
            <input type="text" name="description">
          </div>

          <div class="form-col">
            <label>Niveau impact</label>
            <select name="niveau_impact">
              <option value="Faible">Faible</option>
              <option value="Moyen">Moyen</option>
              <option value="Élevé">Élevé</option>
            </select>
          </div>

        </div>

        <div class="modal-actions">
          <button class="btn btn-success" type="submit">Ajouter</button>
          <button class="btn btn-secondary" type="button" data-close="1">Annuler</button>
        </div>
      </form>
    </div>
  </div>
</div>

{# ================= MODAL EDIT ================= #}
<div class="modal" id="recoEditModal" aria-hidden="true">
  <div class="modal-backdrop" data-close="1"></div>

  <div class="modal-dialog" role="dialog" aria-modal="true">
    <div class="modal-header">
      <h3 class="modal-title">Modifier la recommandation</h3>
      <button class="modal-close" type="button" data-close="1">✕</button>
    </div>

    <div class="modal-body">
      <form method="POST" id="recoEditForm" action="{{ path('front_recommandation_update', {id: 0}) }}">
        <div class="form-grid">

          <div class="form-col">
            <label>Énergie liée</label>
            <select name="energie_id" id="edit_energie" required>
              <option value="">-- choisir --</option>
              {% for e in energies %}
                <option value="{{ e.id }}">{{ e.typeEnergie }} ({{ e.dateEnregistrement ? e.dateEnregistrement|date('Y-m-d') : '' }})</option>
              {% endfor %}
            </select>
          </div>

          <div class="form-col">
            <label>Date de génération</label>
            <input type="date" name="date_generation" id="edit_date">
          </div>

          <div class="form-col-full">
            <label>Titre</label>
            <input type="text" name="titre" id="edit_titre" required>
          </div>

          <div class="form-col-full">
            <label>Description</label>
            <input type="text" name="description" id="edit_description">
          </div>

          <div class="form-col">
            <label>Niveau impact</label>
            <select name="niveau_impact" id="edit_impact">
              <option value="Faible">Faible</option>
              <option value="Moyen">Moyen</option>
              <option value="Élevé">Élevé</option>
            </select>
          </div>

        </div>

        <div class="modal-actions">
          <button class="btn btn-success" type="submit">Modifier</button>
          <button class="btn btn-secondary" type="button" data-close="1">Annuler</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openModal(modal) {
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('modal-open');
  }

  function closeModal(modal) {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('modal-open');
  }

  function wireModalClose(modal) {
    modal.addEventListener('click', (e) => {
      const close = e.target.getAttribute('data-close');
      if (close) closeModal(modal);
    });
  }

  const addModal = document.getElementById('recoAddModal');
  const editModal = document.getElementById('recoEditModal');

  wireModalClose(addModal);
  wireModalClose(editModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (addModal.classList.contains('is-open')) closeModal(addModal);
      if (editModal.classList.contains('is-open')) closeModal(editModal);
    }
  });

  document.getElementById('openAddRecoModal')?.addEventListener('click', () => {
    openModal(addModal);
  });

  document.querySelectorAll('.openEditRecoModal').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id');

      // update action
      const form = document.getElementById('recoEditForm');
      form.action = form.action.replace(/\/\d+\/update$/, '/' + id + '/update');

      document.getElementById('edit_titre').value = btn.getAttribute('data-titre') || '';
      document.getElementById('edit_description').value = btn.getAttribute('data-description') || '';
      document.getElementById('edit_impact').value = btn.getAttribute('data-impact') || 'Faible';
      document.getElementById('edit_date').value = btn.getAttribute('data-date') || '';

      const energieId = btn.getAttribute('data-energie') || '';
      document.getElementById('edit_energie').value = energieId;

      openModal(editModal);
    });
  });

  editModal.addEventListener('click', (e) => {
    if (e.target.getAttribute('data-close')) {
      const form = document.getElementById('recoEditForm');
      if (form) form.action = form.action.replace(/\/\d+\/update$/, '/0/update');
    }
  });
</script>

</body>
</html>
